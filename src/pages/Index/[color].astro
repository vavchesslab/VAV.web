---
import Version2Landing from '../../components/Version2Landing.astro';
import '../../styles/global.css';

export function getStaticPaths() {
	return [
		{ params: { color: '1' } },
		{ params: { color: '2' } },
		{ params: { color: '3' } }
	];
}

type ColorKey = '1' | '2' | '3';
const colorMap = {
	'1': { accent: '#147d72', buttonText: '#ffffff' },
	'2': { accent: '#e81c3e', buttonText: '#ffffff' },
	'3': { accent: '#7c3aed', buttonText: '#121918' }
} satisfies Record<ColorKey, { accent: string; buttonText: string }>;
const color = Astro.params.color as ColorKey;
const selected = colorMap[color] ?? colorMap['2'];
---

<Version2Landing {...selected} activeColor={color ?? '2'} showVersionToggle={false} />
