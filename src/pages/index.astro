---
import Navbar from '../components/Navbar.astro';
import Laboratorio from '../components/Laboratorio.astro';
import Galeria from '../components/Galeria.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import GoUp from '../components/GoUp.astro';
import PlayMode from '../components/PlayMode.astro';
import '../styles/global.css';

const accent = '#e8c031';
const buttonText = '#ffffff';
const goldDeep = '#8f5b16';
const goldBase = '#e8c031';
const goldLight = '#fff1a8';
const goldBright = '#f2c94c';
const goldShadow = '#9b681c';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	</head>
	<body>
		<div id="intro-animation" class="intro-animation" aria-hidden="true">
			<div id="intro-animation-container" class="intro-animation-container"></div>
		</div>

		<div class="version-two-shell" style={`--accent: ${accent}; --button-text: ${buttonText}; --gold-deep: ${goldDeep}; --gold-base: ${goldBase}; --gold-light: ${goldLight}; --gold-bright: ${goldBright}; --gold-shadow: ${goldShadow};`}>
			<Navbar showVersionToggle={false} />

			<main class="page-content min-h-screen py-0">
				<PlayMode />
				<section id="home" class="version-two-hero mx-auto max-w-full">
					<video class="version-two-video" autoplay muted loop playsinline aria-label="Animación de un tablero de ajedrez">
						<source src="https://res.cloudinary.com/lp0nhnzi/video/upload/v1790702953/VideoHeader.mp4" type="video/mp4" />
					</video>
					<div class="version-two-copy">
						<p class="version-two-eyebrow mb-5 text-sm font-semibold uppercase tracking-[0.22em]">Piezas únicas y personalizables</p>
						<h1 class="text-5xl font-semibold leading-[.98] tracking-[-0.04em] sm:text-7xl">Tu próxima jugada empieza ya.</h1>
						<p class="max-w-2xl mt-7 text-lg leading-8 text-(--muted)">Creamos piezas y tableros de ajedrez originales en resina, elaborados artesanalmente en dos líneas: <b>Estándar y Premium.</b> La línea Premium suma piezas imantadas con imanes de neodimio, y ambas cuentan con un packaging de calidad que completa la experiencia VAV.</p>
						<div class="mt-9 flex flex-wrap justify-center gap-3">
							<a class="contact-button rounded-full px-6 py-3 font-semibold transition" href="https://ig.me/m/vavchesslab" target="_blank" rel="noopener noreferrer">Contactar</a>
							<a class="work-button rounded-full border px-6 py-3 font-semibold transition" href="#galeria">Nuestros trabajos</a>
						</div>
					</div>
				</section>

				<Laboratorio
					modelSrc="/rey_regular.glb"
					title="Tu pieza 3D"
					subtitle=""
				/>

				<Galeria />

				<Contacto />
			</main>

			<Footer />

			<GoUp />
		</div>

		<script>
			import lottie from 'lottie-web';

			(() => {
				const container = document.querySelector('#intro-animation-container');
				const introEl = document.querySelector('#intro-animation');
				if (!container || !introEl) return;

				let revealed = false;
				const revealPage = () => {
					if (revealed) return;
					revealed = true;
					document.querySelector('.page-content')?.classList.add('is-visible');
					document.querySelector('.nav-divider')?.classList.add('is-visible');
					introEl.classList.add('is-hidden');
				};

				const anim = lottie.loadAnimation({
					container: container as Element,
					renderer: 'svg',
					loop: false,
					autoplay: true,
					path: `/vav_bk.json?v=${Date.now()}`
				});

				anim.addEventListener('complete', () => {
					setTimeout(revealPage, 300);
				});

				window.setTimeout(revealPage, 3500);
			})();
		</script>
	</body>
</html>