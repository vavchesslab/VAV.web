---
// Visor de imágenes a pantalla completa: es el mismo componente visual que usa
// Galería en mobile (swipe, pinch-zoom, puntos, miniaturas/arrows en desktop).
// API pública:
//   window.VavImageLightbox.open(items, index)  // items = [{ src, alt?, title?, category? }]
//   window.VavImageLightbox.close()
// También se auto-conecta a botones con [data-lightbox-src] agrupados en un
// contenedor con [data-album] o [data-lightbox-group].
---

<div class="galeria__lightbox" id="galeria-lightbox" hidden role="dialog" aria-modal="true" aria-label="Imagen ampliada">
  <div class="galeria__lightbox-toolbar">
    <div>
      <p id="galeria-lightbox-category" class="galeria__lightbox-category"></p>
    </div>
    <button class="galeria__lightbox-close" type="button" aria-label="Cerrar imagen ampliada">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <div class="galeria__lightbox-viewer">
    <button id="galeria-lightbox-prev" class="galeria__lightbox-arrow" type="button" aria-label="Imagen anterior">
      <svg class="galeria__lightbox-arrow-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <img id="galeria-lightbox-image" class="galeria__lightbox-image" alt="" draggable="false" />
    <button id="galeria-lightbox-next" class="galeria__lightbox-arrow" type="button" aria-label="Imagen siguiente">
      <svg class="galeria__lightbox-arrow-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
  <div id="galeria-lightbox-dots" class="galeria__lightbox-dots" role="group" aria-label="Navegación de imágenes"></div>
  <div id="galeria-lightbox-thumbnails" class="galeria__lightbox-thumbnails" aria-label="Miniaturas"></div>
  <p id="galeria-lightbox-position" class="galeria__lightbox-position" aria-live="polite"></p>
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>('#galeria-lightbox');
  const lightboxImage = document.querySelector<HTMLImageElement>('#galeria-lightbox-image');
  const lightboxCategory = document.querySelector<HTMLElement>('#galeria-lightbox-category');
  const lightboxPrev = document.querySelector<HTMLButtonElement>('#galeria-lightbox-prev');
  const lightboxNext = document.querySelector<HTMLButtonElement>('#galeria-lightbox-next');
  const lightboxViewer = document.querySelector<HTMLElement>('.galeria__lightbox-viewer');
  const lightboxDots = document.querySelector<HTMLElement>('#galeria-lightbox-dots');
  const lightboxThumbnails = document.querySelector<HTMLElement>('#galeria-lightbox-thumbnails');
  const lightboxPosition = document.querySelector<HTMLElement>('#galeria-lightbox-position');
  const lightboxClose = document.querySelector<HTMLButtonElement>('.galeria__lightbox-close');

  type LightboxItem = { src: string; alt?: string; title?: string; category?: string };
  let items: LightboxItem[] = [];
  let activeIndex = 0;
  const activePointers = new Map<number, { x: number; y: number }>();
  let zoomScale = 1;
  let zoomPanX = 0;
  let zoomPanY = 0;
  let gestureMode: 'idle' | 'swipe' | 'pan' | 'pinch' = 'idle';
  let gestureHadPinch = false;
  let gestureStartX = 0;
  let gestureStartY = 0;
  let pinchStartDistance = 0;
  let pinchStartScale = 1;
  let pinchStartMidX = 0;
  let pinchStartMidY = 0;
  let pinchStartPanX = 0;
  let pinchStartPanY = 0;
  let panStartX = 0;
  let panStartY = 0;
  let panBaseX = 0;
  let panBaseY = 0;
  let panLastX = 0;
  let panLastY = 0;
  let panLastTime = 0;
  let panVelocityX = 0;
  let panVelocityY = 0;
  let panMomentumFrame = 0;

  if (lightbox) document.body.append(lightbox);

  const isMobileLightbox = () => window.matchMedia('(max-width: 640px)').matches;

  const clampZoomPan = () => {
    if (!lightboxImage || zoomScale <= 1) {
      zoomPanX = 0;
      zoomPanY = 0;
      return;
    }
    const maxX = lightboxImage.clientWidth * (zoomScale - 1) / 2;
    const maxY = lightboxImage.clientHeight * (zoomScale - 1) / 2;
    zoomPanX = Math.max(-maxX, Math.min(maxX, zoomPanX));
    zoomPanY = Math.max(-maxY, Math.min(maxY, zoomPanY));
  };

  const updateImageZoom = () => {
    if (!lightboxImage) return;
    clampZoomPan();
    lightboxImage.style.transform = `translate3d(${zoomPanX}px, ${zoomPanY}px, 0) scale(${zoomScale})`;
    lightboxImage.classList.toggle('is-zoomed', zoomScale > 1.01);
  };

  const stopPanMomentum = () => {
    if (panMomentumFrame) cancelAnimationFrame(panMomentumFrame);
    panMomentumFrame = 0;
    panVelocityX = 0;
    panVelocityY = 0;
  };

  const startPanMomentum = () => {
    if (panMomentumFrame) cancelAnimationFrame(panMomentumFrame);
    panMomentumFrame = 0;
    if (zoomScale <= 1.01 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let previousTime = performance.now();
    const animate = (time: number) => {
      const elapsed = Math.min(32, Math.max(0, time - previousTime));
      previousTime = time;
      if (elapsed === 0) {
        panMomentumFrame = requestAnimationFrame(animate);
        return;
      }

      const nextX = zoomPanX + panVelocityX * elapsed;
      const nextY = zoomPanY + panVelocityY * elapsed;
      zoomPanX = nextX;
      zoomPanY = nextY;
      clampZoomPan();
      if (zoomPanX !== nextX) panVelocityX = 0;
      if (zoomPanY !== nextY) panVelocityY = 0;

      const friction = Math.exp(-0.0055 * elapsed);
      panVelocityX *= friction;
      panVelocityY *= friction;
      updateImageZoom();

      if (Math.abs(panVelocityX) > 0.015 || Math.abs(panVelocityY) > 0.015) {
        panMomentumFrame = requestAnimationFrame(animate);
      } else {
        panMomentumFrame = 0;
      }
    };

    panMomentumFrame = requestAnimationFrame(animate);
  };

  const resetImageZoom = () => {
    stopPanMomentum();
    zoomScale = 1;
    zoomPanX = 0;
    zoomPanY = 0;
    gestureMode = 'idle';
    gestureHadPinch = false;
    activePointers.clear();
    updateImageZoom();
  };

  const getPointerDistance = (first: { x: number; y: number }, second: { x: number; y: number }) =>
    Math.hypot(second.x - first.x, second.y - first.y);

  const startPinchGesture = () => {
    const points = Array.from(activePointers.values());
    if (points.length < 2) return;
    gestureMode = 'pinch';
    gestureHadPinch = true;
    pinchStartDistance = Math.max(1, getPointerDistance(points[0], points[1]));
    pinchStartScale = zoomScale;
    pinchStartMidX = (points[0].x + points[1].x) / 2;
    pinchStartMidY = (points[0].y + points[1].y) / 2;
    pinchStartPanX = zoomPanX;
    pinchStartPanY = zoomPanY;
  };

  const renderThumbnails = () => {
    if (!lightboxThumbnails) return;
    lightboxThumbnails.replaceChildren(...items.map((item, index) => {
      const thumbnail = document.createElement('button');
      thumbnail.type = 'button';
      thumbnail.className = 'galeria__lightbox-thumbnail';
      thumbnail.setAttribute('aria-label', `Ver ${item.title || 'imagen'} ${index + 1}`);
      thumbnail.addEventListener('click', () => showImage(index));
      const image = document.createElement('img');
      image.src = item.src || '';
      image.alt = item.alt || '';
      thumbnail.append(image);
      return thumbnail;
    }));
  };

  const renderDots = () => {
    if (!lightboxDots) return;
    lightboxDots.replaceChildren(...items.map((_item, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'galeria__lightbox-dot';
      dot.setAttribute('aria-label', `Ver imagen ${index + 1} de ${items.length}`);
      dot.setAttribute('aria-current', String(index === activeIndex));
      dot.addEventListener('click', () => showImage(index));
      return dot;
    }));
  };

  const showImage = (index: number) => {
    if (!lightboxImage || items.length === 0) return;
    resetImageZoom();
    activeIndex = (index + items.length) % items.length;
    const item = items[activeIndex];
    lightboxImage.src = item.src || '';
    lightboxImage.alt = item.alt || '';
    if (lightboxCategory) lightboxCategory.textContent = item.category || item.title || '';
    if (lightboxPosition) lightboxPosition.textContent = `Imagen ${activeIndex + 1} de ${items.length}`;
    lightboxDots?.querySelectorAll<HTMLButtonElement>('.galeria__lightbox-dot').forEach((dot, dotIndex) => {
      dot.setAttribute('aria-current', String(dotIndex === activeIndex));
    });
    lightboxThumbnails?.querySelectorAll<HTMLButtonElement>('.galeria__lightbox-thumbnail').forEach((thumbnail, thumbnailIndex) => {
      thumbnail.classList.toggle('is-active', thumbnailIndex === activeIndex);
      if (thumbnailIndex === activeIndex) thumbnail.setAttribute('aria-current', 'true');
      else thumbnail.removeAttribute('aria-current');
    });
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImage) return;
    resetImageZoom();
    lightbox.hidden = true;
    lightboxImage.removeAttribute('src');
    document.body.style.overflow = '';
  };

  const openLightbox = (nextItems: LightboxItem[], startIndex = 0) => {
    if (!lightbox || !lightboxImage || !nextItems || nextItems.length === 0) return;
    items = nextItems;
    activeIndex = ((startIndex % items.length) + items.length) % items.length;
    renderThumbnails();
    renderDots();
    showImage(activeIndex);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  (window as unknown as { VavImageLightbox?: { open: typeof openLightbox; close: typeof closeLightbox } }).VavImageLightbox = {
    open: openLightbox,
    close: closeLightbox
  };

  lightboxPrev?.addEventListener('click', () => showImage(activeIndex - 1));
  lightboxNext?.addEventListener('click', () => showImage(activeIndex + 1));

  lightboxViewer?.addEventListener('pointerdown', (event) => {
    if (!isMobileLightbox() || !lightboxImage) return;
    event.preventDefault();
    activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    if (event.isTrusted) {
      try {
        lightboxViewer.setPointerCapture(event.pointerId);
      } catch {
        // Pointer capture is unavailable in synthetic or cancelled events.
      }
    }

    if (activePointers.size === 1) {
      gestureHadPinch = false;
      stopPanMomentum();
      gestureStartX = event.clientX;
      gestureStartY = event.clientY;
      gestureMode = zoomScale > 1.01 ? 'pan' : 'swipe';
      panStartX = event.clientX;
      panStartY = event.clientY;
      panBaseX = zoomPanX;
      panBaseY = zoomPanY;
      panLastX = event.clientX;
      panLastY = event.clientY;
      panLastTime = event.timeStamp;
    } else if (activePointers.size === 2) {
      startPinchGesture();
    } else {
      gestureHadPinch = true;
      gestureMode = 'pinch';
    }
  });

  lightboxViewer?.addEventListener('pointermove', (event) => {
    if (!isMobileLightbox() || !activePointers.has(event.pointerId)) return;
    activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

    if (gestureMode === 'pinch' && activePointers.size >= 2) {
      const points = Array.from(activePointers.values()).slice(0, 2);
      const midpointX = (points[0].x + points[1].x) / 2;
      const midpointY = (points[0].y + points[1].y) / 2;
      zoomScale = Math.min(4, Math.max(1, pinchStartScale * getPointerDistance(points[0], points[1]) / pinchStartDistance));
      zoomPanX = pinchStartPanX + midpointX - pinchStartMidX;
      zoomPanY = pinchStartPanY + midpointY - pinchStartMidY;
      panVelocityX = 0;
      panVelocityY = 0;
      updateImageZoom();
      return;
    }

    if (gestureMode === 'pan' && activePointers.size === 1 && zoomScale > 1.01) {
      const deltaX = event.clientX - panLastX;
      const deltaY = event.clientY - panLastY;
      const elapsed = Math.max(1, event.timeStamp - panLastTime);
      zoomPanX = panBaseX + event.clientX - panStartX;
      zoomPanY = panBaseY + event.clientY - panStartY;
      panVelocityX = panVelocityX * 0.35 + deltaX / elapsed * 0.65;
      panVelocityY = panVelocityY * 0.35 + deltaY / elapsed * 0.65;
      panLastX = event.clientX;
      panLastY = event.clientY;
      panLastTime = event.timeStamp;
      updateImageZoom();
    }
  });

  const finishPointerGesture = (event: PointerEvent) => {
    if (!activePointers.has(event.pointerId)) return;
    activePointers.delete(event.pointerId);

    if (gestureHadPinch) {
      if (activePointers.size === 1) {
        const remainingPointer = Array.from(activePointers.values())[0];
        gestureMode = 'pan';
        panStartX = remainingPointer.x;
        panStartY = remainingPointer.y;
        panBaseX = zoomPanX;
        panBaseY = zoomPanY;
      } else if (activePointers.size === 0) {
        gestureMode = 'idle';
        gestureHadPinch = false;
      }
      return;
    }

    if (activePointers.size > 0) return;
    if (gestureMode === 'pan') startPanMomentum();
    if (gestureMode === 'swipe' && zoomScale <= 1.01) {
      const deltaX = event.clientX - gestureStartX;
      const deltaY = event.clientY - gestureStartY;
      if (Math.abs(deltaX) >= 55 && Math.abs(deltaX) >= Math.abs(deltaY) * 1.25) {
        showImage(activeIndex + (deltaX < 0 ? 1 : -1));
      }
    }
    gestureMode = 'idle';
  };

  lightboxViewer?.addEventListener('pointerup', finishPointerGesture);
  lightboxViewer?.addEventListener('pointercancel', finishPointerGesture);

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && !target.closest('.galeria__lightbox-image, .galeria__lightbox-arrow, .galeria__lightbox-thumbnail, .galeria__lightbox-dot, .galeria__lightbox-close')) {
      closeLightbox();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
    if (event.key === 'ArrowLeft' && lightbox && !lightbox.hidden) showImage(activeIndex - 1);
    if (event.key === 'ArrowRight' && lightbox && !lightbox.hidden) showImage(activeIndex + 1);
  });

  // Compatibilidad: abre el visor desde botones con [data-lightbox-src] agrupados
  // dentro de un contenedor [data-album] o [data-lightbox-group].
  const bindLightboxGroup = (container: HTMLElement) => {
    const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]'));
    if (buttons.length === 0) return;
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        openLightbox(buttons.map((item) => ({
          src: item.dataset.lightboxSrc || '',
          alt: item.dataset.lightboxAlt || '',
          title: item.dataset.lightboxTitle || '',
          category: item.dataset.lightboxCategory || ''
        })), index);
      });
    });
  };
  document.querySelectorAll<HTMLElement>('[data-album], [data-lightbox-group]').forEach(bindLightboxGroup);
</script>

<style>
  .galeria__lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.88);
  }

  .galeria__lightbox[hidden] {
    display: none;
  }

  .galeria__lightbox-image {
    position: relative;
    z-index: 0;
    max-width: min(82vw, 1100px);
    max-height: min(68vh, 720px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.35rem;
    box-shadow: 0 1rem 4rem rgba(0, 0, 0, 0.55);
    user-select: none;
  }

  .galeria__lightbox-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: min(100%, 1100px);
    min-height: 4rem;
    margin: 0 auto 0.5rem;
    color: #fff;
  }

  .galeria__lightbox-category {
    margin: 0.85rem 0 0.25rem;
    color: var(--gold-bright, #f2c94c);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .galeria__lightbox-title {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1.1;
  }

  .galeria__lightbox-viewer {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: clamp(0.5rem, 3vw, 2rem);
    width: 100%;
    min-height: 0;
  }

  .galeria__lightbox-arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    background: rgba(18, 18, 18, 0.85);
    font-size: 1.5rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .galeria__lightbox-arrow-icon {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .galeria__lightbox-arrow:hover,
  .galeria__lightbox-arrow:focus-visible {
    background: rgba(32, 32, 32, 0.92);
  }

  .galeria__lightbox-thumbnails {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    width: min(100%, 1100px);
    min-height: 4.5rem;
    margin: 0.75rem auto 0;
    overflow-x: auto;
    padding: 0.25rem;
  }

  .galeria__lightbox-dots { display: none; }

  .galeria__lightbox-position {
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.78rem;
    text-align: center;
  }

  .galeria__lightbox-thumbnails :global(.galeria__lightbox-thumbnail) {
    flex: 0 0 4.5rem;
    height: 3.5rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.25rem;
    overflow: hidden;
    background: transparent;
    opacity: 0.62;
    cursor: pointer;
  }

  .galeria__lightbox-thumbnails :global(.galeria__lightbox-thumbnail.is-active) {
    border-color: #e8c031;
    opacity: 1;
    box-shadow: 0 0 0 1px #e8c031, 0 0 0.75rem rgba(232, 192, 49, 0.45);
  }

  .galeria__lightbox-thumbnails :global(.galeria__lightbox-thumbnail img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeria__lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .galeria__lightbox-close svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  .galeria__lightbox-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 640px) {
    .galeria__lightbox {
      padding: 0.75rem;
    }

    .galeria__lightbox-viewer {
      gap: 0;
      touch-action: none;
    }

    .galeria__lightbox-arrow,
    .galeria__lightbox-thumbnails {
      display: none;
    }

    .galeria__lightbox-image {
      max-width: 100%;
      max-height: 68dvh;
      border-radius: 0.25rem;
      transform-origin: center;
      touch-action: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    .galeria__lightbox-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 1.75rem;
      padding-top: 0.5rem;
    }

    :global(.galeria__lightbox-dot) {
      width: 0.4rem;
      height: 0.4rem;
      flex: 0 0 auto;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.42);
      cursor: pointer;
    }

    :global(.galeria__lightbox-dot[aria-current="true"]) {
      background: #ffffff;
      transform: scale(1.25);
    }

    :global(.galeria__lightbox-dot:focus-visible) {
      outline: 2px solid var(--gold-base, #e8c031);
      outline-offset: 3px;
    }

    .galeria__lightbox-position {
      position: absolute;
      top: calc(env(safe-area-inset-top, 0px) + 3.5rem);
      right: auto;
      left: 0.5rem;
      z-index: 2;
      min-height: 0;
      margin: 0;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      color: #ffffff;
      background: rgba(0, 0, 0, 0.58);
      font-size: 0.72rem;
    }

    /* Ajustes finales que la Galería aplica en mobile. */
    .galeria__lightbox {
      padding: 1rem;
    }

    .galeria__lightbox-viewer {
      gap: 0.35rem;
    }

    .galeria__lightbox-arrow {
      width: 2.25rem;
      height: 2.25rem;
    }

    .galeria__lightbox-image {
      max-width: 78vw;
      max-height: 68vh;
    }

    .galeria__lightbox-thumbnails {
      justify-content: flex-start;
    }
  }
</style>
