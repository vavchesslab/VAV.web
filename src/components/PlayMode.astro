---
---

<section id="play-mode" class="play-mode" aria-label="Jugar contra la PC" hidden>
	<div class="play-mode__panel">
		<button id="play-mode-close" class="play-mode__close" type="button" aria-label="Cerrar partida">
			<span class="play-mode__close-x" aria-hidden="true">&times;</span>
			<svg class="play-mode__close-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
		<div class="play-mode__content">
		<header class="play-mode__header">
			<div>
				<h2>Jugar contra la PC</h2>
				<p id="play-mode-status" class="play-mode__status" aria-live="polite">Tu turno. Elegí una pieza blanca.</p>
			</div>
			<div class="play-mode__header-actions">
				<button id="play-mode-settings-toggle" class="play-mode__settings-toggle" type="button" aria-label="Abrir configuración" aria-controls="play-mode-settings" aria-expanded="false" title="Configuración" hidden>
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M12.22 2h-.44a2 2 0 0 0-2 1.72l-.13.96a2 2 0 0 1-1 1.73l-.87.5a2 2 0 0 1-1.99-.02l-.83-.48a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.83.48a2 2 0 0 1 1 1.72v1a2 2 0 0 1-1 1.73l-.83.48a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.83-.48a2 2 0 0 1 1.99-.02l.87.5a2 2 0 0 1 1 1.73l.13.96a2 2 0 0 0 2 1.72h.44a2 2 0 0 0 2-1.72l.13-.96a2 2 0 0 1 1-1.73l.87-.5a2 2 0 0 1 1.99.02l.83.48a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.83-.48a2 2 0 0 1-1-1.72v-1a2 2 0 0 1 1-1.73l.83-.48a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.83.48a2 2 0 0 1-1.99-.02l-.87-.5a2 2 0 0 1-1-1.73l-.13-.96a2 2 0 0 0-2-1.72Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
						<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" />
					</svg>
				</button>
			</div>
		</header>

		<div class="play-mode__body">
			<div class="play-mode__board-wrap">
				<div id="play-mode-board" class="play-mode__board" role="grid" aria-label="Tablero de ajedrez"></div>
				<div id="play-mode-result" class="play-mode__result" hidden role="status" aria-live="assertive">¡Ganaste!</div>
			</div>
			<aside id="play-mode-settings" class="play-mode__side-panel">
				<div class="play-mode__side-block">
					<span class="play-mode__label">Tu color</span>
					<div class="play-mode__color-actions">
						<button class="play-mode__color is-active" type="button" data-player-color="w">Blancas</button>
						<button class="play-mode__color" type="button" data-player-color="b">Negras</button>
					</div>
				</div>
				<div class="play-mode__side-block play-mode__side-block--difficulty">
					<span id="play-mode-level-label" class="play-mode__label">Dificultad</span>
					<div class="play-mode__select-shell">
						<input id="play-mode-level" type="hidden" value="14" />
						<button id="play-mode-level-selector" class="play-mode__select" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="play-mode-level-options" aria-labelledby="play-mode-level-label play-mode-level-current">
							<span id="play-mode-level-current">Normal</span>
							<svg class="play-mode__select-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="play-mode-level-options" class="play-mode__level-options" role="listbox" aria-labelledby="play-mode-level-label" hidden>
							<button class="play-mode__level-option" type="button" role="option" aria-selected="false" tabindex="-1" data-level="8">Fácil</button>
							<button class="play-mode__level-option" type="button" role="option" aria-selected="true" tabindex="0" data-level="14">Normal</button>
							<button class="play-mode__level-option" type="button" role="option" aria-selected="false" tabindex="-1" data-level="20">Difícil</button>
						</div>
					</div>
				</div>
				<button id="play-mode-reset" class="play-mode__reset" type="button">Nueva partida</button>
			</aside>
			<p class="play-mode__hint"><em>Powered by <strong>sinccsdgn</strong></em></p>
		</div>
		</div>
	</div>
</section>

<script>
	import { Chess } from 'chess.js';

	type PlayerColor = 'w' | 'b';
	type PieceType = 'p' | 'n' | 'b' | 'r' | 'q' | 'k';
	type BoardSquare = Parameters<Chess['get']>[0];
	type BoardPiece = { color: PlayerColor; type: PieceType };
	type BoardAnimation = { from: BoardSquare; to: BoardSquare };

	const playMode = document.querySelector<HTMLElement>('#play-mode');
	const board = document.querySelector<HTMLElement>('#play-mode-board');
	const status = document.querySelector<HTMLElement>('#play-mode-status');
	const resultBanner = document.querySelector<HTMLElement>('#play-mode-result');
	const closeButton = document.querySelector<HTMLButtonElement>('#play-mode-close');
	const resetButton = document.querySelector<HTMLButtonElement>('#play-mode-reset');
	const settingsToggle = document.querySelector<HTMLButtonElement>('#play-mode-settings-toggle');
	const settingsPanel = document.querySelector<HTMLElement>('#play-mode-settings');
	const playBody = document.querySelector<HTMLElement>('.play-mode__body');
		const levelSelect = document.querySelector<HTMLInputElement>('#play-mode-level');
		const levelSelector = document.querySelector<HTMLButtonElement>('#play-mode-level-selector');
		const levelCurrent = document.querySelector<HTMLElement>('#play-mode-level-current');
		const levelOptions = document.querySelector<HTMLElement>('#play-mode-level-options');
		const levelOptionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.play-mode__level-option'));
	const colorButtons = document.querySelectorAll<HTMLButtonElement>('[data-player-color]');

	if (playMode && board && status) {
		if (playMode.parentElement !== document.body) {
			document.body.append(playMode);
		}
		const mobileSettings = window.matchMedia('(max-width: 720px)');
		let isMobileSettingsOpen = false;
		const syncSettingsVisibility = () => {
			if (!settingsToggle || !settingsPanel) return;
			settingsToggle.hidden = !mobileSettings.matches;
			settingsPanel.hidden = mobileSettings.matches && !isMobileSettingsOpen;
			settingsToggle.setAttribute('aria-expanded', String(mobileSettings.matches && isMobileSettingsOpen));
			settingsToggle.setAttribute('aria-label', isMobileSettingsOpen ? 'Cerrar configuración' : 'Abrir configuración');
			playBody?.classList.toggle('is-settings-open', mobileSettings.matches && isMobileSettingsOpen);
		};
		settingsToggle?.addEventListener('click', () => {
			isMobileSettingsOpen = !isMobileSettingsOpen;
			syncSettingsVisibility();
		});
		mobileSettings.addEventListener('change', () => {
			isMobileSettingsOpen = false;
			syncSettingsVisibility();
		});
		syncSettingsVisibility();

		const pieceSymbols: Record<PieceType, [string, string]> = {
			p: [String.fromCodePoint(9817), String.fromCodePoint(9823)],
			n: [String.fromCodePoint(9816), String.fromCodePoint(9822)],
			b: [String.fromCodePoint(9815), String.fromCodePoint(9821)],
			r: [String.fromCodePoint(9814), String.fromCodePoint(9820)],
			q: [String.fromCodePoint(9813), String.fromCodePoint(9819)],
			k: [String.fromCodePoint(9812), String.fromCodePoint(9818)]
		};
		const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'] as const;
		const game = new Chess();
		let playerColor: PlayerColor = 'w';
		let selectedPlayerColor: PlayerColor = playerColor;
		let activeEngineDepth = 14;
		let selectedSquare: BoardSquare | null = null;
		let engine: Worker | null = null;
		let engineReady = false;
		let engineThinking = false;
		let pendingEngineMove: number | undefined;
		const gameButton = document.querySelector<HTMLElement>('.navbar-game-link');
		const mobileNavActions = document.querySelector<HTMLElement>('#navbar-menu .nav-actions');
		const playPanel = playMode.querySelector<HTMLElement>('.play-mode__panel');
		const desktopGameLayout = window.matchMedia('(min-width: 1280px)');

		const positionPlayMode = () => {
			if (!desktopGameLayout.matches) {
				const actionsRect = mobileNavActions?.getBoundingClientRect();
				const headerBottom = document.querySelector('.sticky-nav-header')?.getBoundingClientRect().bottom || 0;
				const panelTop = (actionsRect?.height ? actionsRect.bottom : headerBottom) + 12;
				playMode.style.top = `${panelTop}px`;
				playMode.style.left = '0.6rem';
				playMode.style.right = '0.6rem';
				playPanel?.style.setProperty('max-height', `${Math.max(180, window.innerHeight - panelTop - 12)}px`);
				return;
			}
			playMode.style.removeProperty('left');
			playMode.style.removeProperty('top');
			playMode.style.removeProperty('right');
			playPanel?.style.removeProperty('max-height');
			if (!gameButton) return;
			const buttonRect = gameButton.getBoundingClientRect();
			playMode.style.top = `${buttonRect.bottom + 10}px`;
			playMode.style.right = `${Math.max(0, document.documentElement.clientWidth - buttonRect.right)}px`;
		};

		const pieceLabel = (piece: BoardPiece) => {
			const names: Record<PieceType, string> = { p: 'peon', n: 'caballo', b: 'alfil', r: 'torre', q: 'reina', k: 'rey' };
			return `${piece.color === 'w' ? 'blanco' : 'negro'} ${names[piece.type]}`;
		};

		const setStatus = (message: string) => {
			status.textContent = message;
		};

		const stopEngine = () => {
			if (pendingEngineMove) window.clearTimeout(pendingEngineMove);
			engine?.terminate();
			engine = null;
			engineReady = false;
			engineThinking = false;
		};

		const startEngine = () => {
			if (engine) return;
			engine = new Worker('/stockfish-19-lite-single.js');
			engine.addEventListener('message', (event) => {
				const message = String(event.data || '');
				if (message === 'uciok') {
					engine?.postMessage('isready');
				}
				if (message === 'readyok') {
					engineReady = true;
					requestEngineMove();
				}
				if (message.startsWith('bestmove')) {
					const move = message.split(' ')[1];
					if (move && move !== '(none)' && game.turn() !== playerColor) {
						const from = move.slice(0, 2) as BoardSquare;
						const to = move.slice(2, 4) as BoardSquare;
						setStatus('La PC está por mover...');
						pendingEngineMove = window.setTimeout(() => {
							pendingEngineMove = undefined;
							try {
								game.move({ from, to, promotion: move[4] || 'q' });
								renderBoard({ from, to });
							} catch {
								setStatus('La PC no pudo completar la jugada. Reiniciá la partida.');
							}
							engineThinking = false;
							updateStatus();
						}, 500);
					} else {
						engineThinking = false;
						renderBoard();
						updateStatus();
					}
				}
			});
			engine.postMessage('uci');
		};

		const requestEngineMove = () => {
			if (!engine || !engineReady || engineThinking || game.isGameOver() || game.turn() === playerColor) return;
			engineThinking = true;
			setStatus('La PC está pensando...');
			engine.postMessage(`position fen ${game.fen()}`);
			engine.postMessage(`go depth ${activeEngineDepth}`);
		};

		const showResultBanner = (message: string) => {
			if (!resultBanner) return;
			resultBanner.textContent = message;
			resultBanner.hidden = false;
		};

		const hideResultBanner = () => {
			if (!resultBanner) return;
			resultBanner.hidden = true;
		};

		const updateStatus = () => {
			if (game.isCheckmate()) {
				const playerWon = game.turn() !== playerColor;
				setStatus(playerWon ? 'Jaque mate. Ganaste.' : 'Jaque mate. Ganó la PC.');
				if (playerWon) showResultBanner('¡Ganaste!');
			} else if (game.isDraw()) {
				setStatus('Tablas. La partida terminó empatada.');
			} else if (game.inCheck()) {
				setStatus(game.turn() === playerColor ? 'Estás en jaque.' : 'La PC está en jaque.');
				if (game.turn() !== playerColor) requestEngineMove();
			} else if (game.turn() === playerColor) {
				setStatus('Tu turno. Elegí una pieza.');
			} else {
				requestEngineMove();
			}
		};

		const findKingSquare = (color: PlayerColor): BoardSquare | null => {
			for (const file of files) {
				for (let rank = 1; rank <= 8; rank += 1) {
					const square = `${file}${rank}` as BoardSquare;
					const piece = game.get(square);
					if (piece?.type === 'k' && piece.color === color) return square;
				}
			}
			return null;
		};

		const renderBoard = (animation?: BoardAnimation) => {
			const origin = animation
				? board.querySelector<HTMLElement>(`[data-square="${animation.from}"]`)?.getBoundingClientRect()
				: undefined;
			board.replaceChildren();
			const ranks = playerColor === 'w' ? [8, 7, 6, 5, 4, 3, 2, 1] : [1, 2, 3, 4, 5, 6, 7, 8];
			const orderedFiles = playerColor === 'w' ? files : [...files].reverse();
			const checkedKingSquare = game.inCheck() ? findKingSquare(game.turn()) : null;
			ranks.forEach((rank, rankIndex) => {
				orderedFiles.forEach((file, fileIndex) => {
					const square = `${file}${rank}` as BoardSquare;
					const piece = game.get(square);
					const tile = document.createElement('button');
					let pieceElement: HTMLSpanElement | null = null;
					tile.type = 'button';
					tile.className = `play-mode__square ${(rankIndex + fileIndex) % 2 === 0 ? 'is-light' : 'is-dark'}`;
					tile.dataset.square = square;
					tile.setAttribute('role', 'gridcell');
					tile.setAttribute('aria-label', piece ? `${square}, ${pieceLabel(piece)}` : square);
					if (selectedSquare === square) tile.classList.add('is-selected');
					if (checkedKingSquare === square) tile.classList.add('is-check');
					if (piece) {
						tile.classList.add(piece.color === 'w' ? 'piece-white' : 'piece-black');
						pieceElement = document.createElement('span');
						pieceElement.className = 'play-mode__piece';
						pieceElement.textContent = pieceSymbols[piece.type][piece.color === 'w' ? 0 : 1];
						tile.append(pieceElement);
					}
					tile.addEventListener('click', () => handleSquareClick(square));
					board.append(tile);
					if (animation?.to === square && origin && pieceElement) {
						const destination = tile.getBoundingClientRect();
						pieceElement.style.setProperty('--move-x', `${origin.left - destination.left}px`);
						pieceElement.style.setProperty('--move-y', `${origin.top - destination.top}px`);
						pieceElement.classList.add('is-moving');
						window.setTimeout(() => pieceElement?.classList.remove('is-moving'), 560);
					}
				});
			});
		};

		const handleSquareClick = (square: BoardSquare) => {
			if (engineThinking || game.isGameOver() || game.turn() !== playerColor) return;
			const piece = game.get(square);
			if (selectedSquare) {
				try {
					const from = selectedSquare;
					game.move({ from: selectedSquare, to: square, promotion: 'q' });
					selectedSquare = null;
					renderBoard({ from, to: square });
					updateStatus();
					return;
				} catch {
					selectedSquare = piece?.color === playerColor ? square : null;
				}
			} else if (piece?.color === playerColor) {
				selectedSquare = square;
			}
			renderBoard();
		};

		const resetGame = () => {
			if (pendingEngineMove) window.clearTimeout(pendingEngineMove);
			pendingEngineMove = undefined;
			playerColor = selectedPlayerColor;
			activeEngineDepth = Number(levelSelect?.value) || 14;
			game.reset();
			selectedSquare = null;
			engineThinking = false;
			hideResultBanner();
			renderBoard();
			updateStatus();
		};

		const openGame = () => {
			playMode.hidden = false;
			isMobileSettingsOpen = false;
			syncSettingsVisibility();
			gameButton?.setAttribute('aria-pressed', 'true');
			document.body.style.overflow = '';
			positionPlayMode();
			startEngine();
		};

		const closeGame = () => {
			playMode.hidden = true;
			isMobileSettingsOpen = false;
			syncSettingsVisibility();
			gameButton?.setAttribute('aria-pressed', 'false');
			document.body.style.overflow = '';
		};

		gameButton?.addEventListener('click', () => {
			if (playMode.hidden) openGame();
			else closeGame();
		});
		const closeLevelOptions = (restoreFocus = false) => {
			if (!levelSelector || !levelOptions) return;
			levelSelector.setAttribute('aria-expanded', 'false');
			levelOptions.hidden = true;
			if (restoreFocus) levelSelector.focus();
		};
		const openLevelOptions = () => {
			if (!levelSelector || !levelOptions) return;
			levelSelector.setAttribute('aria-expanded', 'true');
			levelOptions.hidden = false;
			(levelOptionButtons.find((option) => option.getAttribute('aria-selected') === 'true') || levelOptionButtons[0])?.focus();
		};
		const selectLevel = (option: HTMLButtonElement) => {
			const value = option.dataset.level;
			if (!value || !levelSelect || !levelCurrent) return;

			levelSelect.value = value;
			levelCurrent.textContent = option.textContent?.trim() || '';
			levelOptionButtons.forEach((item) => {
				const isSelected = item === option;
				item.setAttribute('aria-selected', String(isSelected));
				item.tabIndex = isSelected ? 0 : -1;
			});
			closeLevelOptions(true);
		};

		levelSelector?.addEventListener('click', () => {
			if (levelSelector.getAttribute('aria-expanded') === 'true') closeLevelOptions();
			else openLevelOptions();
		});
		levelSelector?.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
				event.preventDefault();
				event.stopPropagation();
				openLevelOptions();
			} else if (event.key === 'Escape' && levelSelector.getAttribute('aria-expanded') === 'true') {
				event.preventDefault();
				event.stopPropagation();
				closeLevelOptions(true);
			}
		});
		levelOptions?.addEventListener('click', (event) => {
			const option = (event.target as Element).closest<HTMLButtonElement>('.play-mode__level-option');
			if (option) selectLevel(option);
		});
		levelOptions?.addEventListener('keydown', (event) => {
			const currentIndex = levelOptionButtons.indexOf(document.activeElement as HTMLButtonElement);
			let nextIndex = currentIndex;

			if (event.key === 'ArrowDown') nextIndex = (currentIndex + 1) % levelOptionButtons.length;
			else if (event.key === 'ArrowUp') nextIndex = (currentIndex - 1 + levelOptionButtons.length) % levelOptionButtons.length;
			else if (event.key === 'Home') nextIndex = 0;
			else if (event.key === 'End') nextIndex = levelOptionButtons.length - 1;
			else if (event.key === 'Escape') {
				event.preventDefault();
				event.stopPropagation();
				closeLevelOptions(true);
				return;
			} else if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				levelOptionButtons[currentIndex]?.click();
				return;
			} else {
				return;
			}

			event.preventDefault();
			levelOptionButtons[nextIndex]?.focus();
		});
		document.addEventListener('click', (event) => {
			if (event.target instanceof Node && !document.querySelector('.play-mode__select-shell')?.contains(event.target)) {
				closeLevelOptions();
			}
		});
		window.addEventListener('resize', positionPlayMode);
		closeButton?.addEventListener('click', closeGame);
		resetButton?.addEventListener('click', resetGame);
		playMode.addEventListener('click', (event) => {
			if (event.target === playMode) closeGame();
		});
		colorButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const nextColor = button.dataset.playerColor;
				if (nextColor !== 'w' && nextColor !== 'b') return;
				selectedPlayerColor = nextColor;
				colorButtons.forEach((item) => item.classList.toggle('is-active', item === button));
			});
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !playMode.hidden) closeGame();
		});

		renderBoard();
	}
</script>

<style>
	.play-mode {
		position: fixed;
		top: 4.7rem;
		right: 1rem;
		z-index: 300;
		display: grid;
		align-items: start;
		justify-items: end;
		padding: 0;
		pointer-events: none;
	}

	.play-mode[hidden] {
		display: none;
	}

	.play-mode__panel {
		position: relative;
		width: min(100%, 430px);
		max-height: calc(100dvh - 5.7rem);
		overflow: visible;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 0.9rem;
		background: #0d191b;
		box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.5);
		pointer-events: auto;
	}

	.play-mode__content {
		max-height: inherit;
		overflow: auto;
		padding: 1rem;
		border-radius: inherit;
	}

	.play-mode__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.play-mode__eyebrow,
	.play-mode__status,
	.play-mode__header h2,
	.play-mode__hint {
		margin: 0;
	}

	.play-mode__eyebrow {
		color: var(--gold-base);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.play-mode__header h2 {
		margin-top: 0.3rem;
		color: #ffffff;
		font-size: clamp(1.3rem, 3vw, 2rem);
	}

	.play-mode__status {
		margin-top: 0.45rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.play-mode__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		color: #ffffff;
		font-size: 1.5rem;
		cursor: pointer;
		pointer-events: auto;
	}

	.play-mode__close-arrow {
		display: none;
	}

	.play-mode__header-actions {
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		flex: 0 0 auto;
	}

	.play-mode__settings-toggle {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		color: #ffffff;
		background: rgba(255, 255, 255, 0.06);
		cursor: pointer;
	}

	.play-mode__settings-toggle svg {
		width: 1.15rem;
