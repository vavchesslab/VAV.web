---
const {
  modelSrc = '/caballo.glb',
  title = 'OBJETOS 3D',
  subtitle = 'Vista interactiva del objeto'
} = Astro.props;
---

<section id="laboratorio" class="model-showcase" aria-labelledby="model-showcase-title">
  <div class="model-showcase__inner">
    <div class="text-center mb-6">
      <p class="mt-6 mb-2 text-lg font-semibold uppercase tracking-[0.22em] text-(--accent)">Laboratorio</p>
      <p class="text-base text-(--muted) max-w-xl mx-auto">{subtitle}</p>
    </div>
    <div class="model-showcase__layout">
      <div id="model-showcase-viewer" class="model-showcase__viewer" data-model-src={modelSrc}>
        <div class="model-showcase__top-bar">
          <div class="model-showcase__palette" role="group" aria-label="Elegir entre piezas y tableros">
            <button type="button" class="theme-option is-active" data-mode="piece" aria-label="Mostrar pieza">
              Piezas
            </button>
            <button type="button" class="theme-option" data-mode="board" data-model="/tablero.glb" aria-label="Mostrar tablero">
              Tableros
            </button>
          </div>

          <div class="piece-team-controls" role="group" aria-label="Elegir bando de piezas">
            <button type="button" class="piece-team-btn is-active" data-team="Blancas" aria-label="Personalizar Piezas Blancas">
              Blancas
            </button>
            <button type="button" class="piece-team-btn" data-team="Negras" aria-label="Personalizar Piezas Negras">
              Negras
            </button>
          </div>
        </div>

        <div class="model-showcase__piece-nav" aria-label="Navegación entre piezas">
          <button type="button" class="piece-nav-button piece-nav-button--prev" data-direction="-1" aria-label="Pieza anterior">
            <svg class="piece-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="piece-nav-button piece-nav-button--next" data-direction="1" aria-label="Siguiente pieza">
            <svg class="piece-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <div class="group-color-controls" aria-label="Colores del tablero">
          <div class="group-color-picker">
            <div class="group-color-picker__header">
              <span>Color 1</span>
              <button type="button" class="board-color-toggle" aria-expanded="true" aria-label="Colapsar Color 1">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <div class="group-color-picker__content">
              <input id="white-squares-color-picker" type="hidden" value="#f3f3f3" data-target="Blancas" />
              <div class="board-color-palette" data-target="Blancas" role="group" aria-label="Elegir color 1"></div>
            </div>
          </div>
          <button type="button" class="match-pieces-btn" id="match-pieces-btn">
            Emparejar<br />color de piezas
          </button>
          <div class="group-color-picker">
            <div class="group-color-picker__header">
              <span>Color 2</span>
              <button type="button" class="board-color-toggle" aria-expanded="true" aria-label="Colapsar Color 2">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <div class="group-color-picker__content">
              <input id="black-squares-color-picker" type="hidden" value="#1f1f1f" data-target="Negras" />
              <div class="board-color-palette" data-target="Negras" role="group" aria-label="Elegir color 2"></div>
            </div>
          </div>
        </div>

        <div class="model-showcase__controls">
          <div class="model-color-picker">
            <div class="model-color-picker__header">
              <span>Color</span>
              <button type="button" class="model-color-toggle" aria-expanded="true" aria-controls="piece-color-palette" aria-label="Colapsar selector de color">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <input id="piece-color-picker" type="hidden" value="#efece7" />
            <div id="piece-color-palette" class="color-palette" role="group" aria-label="Elegir color de la pieza">
              <div class="color-palette__column" aria-label="Grises">
                <button type="button" class="color-swatch" style="--swatch: #ffffff" data-color="#ffffff" aria-label="Blanco"></button>
                <button type="button" class="color-swatch" style="--swatch: #d9d9d9" data-color="#d9d9d9" aria-label="Gris claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #aaaaaa" data-color="#aaaaaa" aria-label="Gris medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #777777" data-color="#777777" aria-label="Gris medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #444444" data-color="#444444" aria-label="Gris oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #111111" data-color="#111111" aria-label="Negro"></button>
              </div>
              <div class="color-palette__column" aria-label="Azules">
                <button type="button" class="color-swatch" style="--swatch: #dbeafe" data-color="#dbeafe" aria-label="Azul muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #93c5fd" data-color="#93c5fd" aria-label="Azul claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #60a5fa" data-color="#60a5fa" aria-label="Azul medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #2563eb" data-color="#2563eb" aria-label="Azul medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #1d4ed8" data-color="#1d4ed8" aria-label="Azul oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #172554" data-color="#172554" aria-label="Azul muy oscuro"></button>
              </div>
              <div class="color-palette__column" aria-label="Rojos">
                <button type="button" class="color-swatch" style="--swatch: #fee2e2" data-color="#fee2e2" aria-label="Rojo muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #fca5a5" data-color="#fca5a5" aria-label="Rojo claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #f87171" data-color="#f87171" aria-label="Rojo medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #dc2626" data-color="#dc2626" aria-label="Rojo medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #b91c1c" data-color="#b91c1c" aria-label="Rojo oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #450a0a" data-color="#450a0a" aria-label="Rojo muy oscuro"></button>
              </div>
              <div class="color-palette__column" aria-label="Verdes">
                <button type="button" class="color-swatch" style="--swatch: #dcfce7" data-color="#dcfce7" aria-label="Verde muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #86efac" data-color="#86efac" aria-label="Verde claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #4ade80" data-color="#4ade80" aria-label="Verde medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #16a34a" data-color="#16a34a" aria-label="Verde medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #15803d" data-color="#15803d" aria-label="Verde oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #052e16" data-color="#052e16" aria-label="Verde muy oscuro"></button>
              </div>
              <div class="color-palette__column" aria-label="Amarillos">
                <button type="button" class="color-swatch" style="--swatch: #fef9c3" data-color="#fef9c3" aria-label="Amarillo muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #fde68a" data-color="#fde68a" aria-label="Amarillo claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #facc15" data-color="#facc15" aria-label="Amarillo medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #eab308" data-color="#eab308" aria-label="Amarillo medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #a16207" data-color="#a16207" aria-label="Amarillo oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #422006" data-color="#422006" aria-label="Amarillo muy oscuro"></button>
              </div>
              <div class="color-palette__column" aria-label="Violetas y rosas">
                <button type="button" class="color-swatch" style="--swatch: #fce7f3" data-color="#fce7f3" aria-label="Rosa muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #f9a8d4" data-color="#f9a8d4" aria-label="Rosa claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #e879f9" data-color="#e879f9" aria-label="Fucsia claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #c026d3" data-color="#c026d3" aria-label="Violeta rosado"></button>
                <button type="button" class="color-swatch" style="--swatch: #7e22ce" data-color="#7e22ce" aria-label="Violeta oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #3b0764" data-color="#3b0764" aria-label="Violeta muy oscuro"></button>
              </div>
              <div class="color-palette__column" aria-label="Naranjas">
                <button type="button" class="color-swatch" style="--swatch: #ffedd5" data-color="#ffedd5" aria-label="Naranja muy claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #fdba74" data-color="#fdba74" aria-label="Naranja claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #fb923c" data-color="#fb923c" aria-label="Naranja medio claro"></button>
                <button type="button" class="color-swatch" style="--swatch: #ea580c" data-color="#ea580c" aria-label="Naranja medio"></button>
                <button type="button" class="color-swatch" style="--swatch: #c2410c" data-color="#c2410c" aria-label="Naranja oscuro"></button>
                <button type="button" class="color-swatch" style="--swatch: #431407" data-color="#431407" aria-label="Naranja muy oscuro"></button>
              </div>
            </div>
          </div>
        </div>

        <div class="model-fallback">Cargando modelo...</div>
        <p class="model-showcase__model-name" aria-live="polite">Caballo</p>
        <button type="button" class="model-showcase__continue" aria-controls="model-showcase-editor" aria-expanded="false">
          Continuar
          <svg class="model-showcase__button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="model-showcase__back" aria-controls="model-showcase-viewer" aria-hidden="true">
          <svg class="model-showcase__button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Volver
        </button>
      </div>

      <aside id="model-showcase-editor" class="model-showcase__editor" aria-label="Visor del resultado final" aria-hidden="true">
        <div class="model-showcase__editor-header">
          <div class="model-showcase__editor-title">
            <p>Resultado final</p>
          </div>
          <div class="final-colors-summary" aria-label="Colores seleccionados">
            <span class="final-color-chip" title="Piezas Blancas"><span class="final-color-dot" id="final-dot-white-piece"></span> Blancas</span>
            <span class="final-color-chip" title="Piezas Negras"><span class="final-color-dot" id="final-dot-black-piece"></span> Negras</span>
            <span class="final-color-chip" title="Casillas Color 1"><span class="final-color-dot" id="final-dot-white-board"></span> C1</span>
            <span class="final-color-chip" title="Casillas Color 2"><span class="final-color-dot" id="final-dot-black-board"></span> C2</span>
          </div>
        </div>
        <div id="final-model-container" class="final-model-container">
          <div class="final-model-fallback">Cargando resultado final...</div>
        </div>
        <div class="model-showcase__editor-summary">
          <span>Vista Completa 3D</span>
          <small class="final-hint">Gira y explora el conjunto</small>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .model-showcase {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 2rem 0 5rem;
    background: #050d0f;
  }

  .model-showcase__inner {
    position: relative;
    display: grid;
    gap: 1rem;
    width: min(100%, 1500px);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .model-showcase__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    align-items: center;
    justify-items: center;
    transition: grid-template-columns 0.85s cubic-bezier(0.22, 1, 0.36, 1), gap 0.85s ease;
  }

  .model-showcase__layout.is-revealed {
    grid-template-columns: minmax(0, 560px) minmax(0, 600px);
    gap: 1rem;
    justify-items: stretch;
    justify-content: center;
  }

  .model-showcase__editor {
    --editor-width: 600px;
    --editor-height: 600px;
    display: none;
    gap: 1.25rem;
    padding: 1.1rem 1rem 1rem;
    width: min(var(--editor-width), 100%);
    height: var(--editor-height);
    justify-self: start;
    box-sizing: border-box;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 1.3rem;
    background: rgba(12, 22, 26, 0.8);
    box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.2);
    color: #f5f5f5;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-2rem) scale(0.98);
    transform-origin: left center;
    transition: opacity 0.55s ease 0.28s, transform 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  }

  .model-showcase__layout.is-revealed .model-showcase__editor {
    display: grid;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0) scale(1);
  }

  .model-showcase__layout.is-revealed .model-showcase__viewer {
    transform: translateX(0);
    width: min(560px, 100%);
  }

  .model-showcase__viewer {
    transition: width 0.85s cubic-bezier(0.22, 1, 0.36, 1), transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .model-showcase__editor-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }

  .model-showcase__editor-header p {
    margin: 0;
    color: #ffffff;
    font-weight: 700;
  }

  .model-showcase__editor-title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .model-showcase__back {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    color: #f13e3e;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .model-showcase__layout.is-revealed .model-showcase__back {
    opacity: 1;
    pointer-events: auto;
  }

  .model-showcase__button-icon {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    stroke-width: 2.2;
    transition: transform 0.25s ease;
  }

  .model-showcase__continue:hover .model-showcase__button-icon {
    transform: translateX(0.15rem);
  }

  .model-showcase__back:hover .model-showcase__button-icon {
    transform: translateX(-0.15rem);
  }

  .model-showcase__back:hover,
  .model-showcase__back:focus-visible {
    border-color: #f13e3e;
    background: rgba(241, 62, 62, 0.12);
    color: #ff6b6b;
  }

  .piece-team-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.015);
    opacity: 0.82;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .piece-team-controls::before {
    margin: 0 0.3rem 0 0.2rem;
    color: rgba(255, 255, 255, 0.42);
    content: 'Bando';
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .piece-team-btn {
    appearance: none;
    border: 0;
    border-radius: 0.45rem;
    padding: 0.32rem 0.55rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .piece-team-btn:hover {
    color: #ffffff;
    transform: translateY(-1px);
  }

  .piece-team-btn.is-active {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform: none;
  }

  .final-colors-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .final-color-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .final-color-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    display: inline-block;
  }

  .final-model-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(14, 28, 32, 0.95), rgba(6, 14, 16, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .final-model-container canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .final-model-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .final-hint {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.68rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .model-showcase__editor-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
  }

  .model-showcase__editor-summary strong {
    color: #ffffff;
    font-weight: 700;
  }

  .model-showcase__viewer {
    --viewer-width: 760px;
    --viewer-height: 600px;
    position: relative;
    width: min(var(--viewer-width), 100%);
    height: var(--viewer-height);
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--gold-light) 70%, transparent);
    border-radius: 1.3rem;
    background: linear-gradient(135deg, rgba(18, 44, 40, 0.95), rgba(121, 131, 128, 0.8));
    box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.35);
    overflow: visible;
  }

  .model-showcase__viewer::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    height: 55%;
    border-radius: 0 0 1.3rem 1.3rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), transparent);
    content: '';
    pointer-events: none;
  }

  :global(.model-showcase__viewer canvas) {
    display: block;
    position: relative;
    z-index: 0;
    width: 100% !important;
    height: 100% !important;
    border-radius: 1.3rem !important;
  }

  .model-showcase__continue {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--gold-base);
    border-radius: 999px;
    background: linear-gradient(115deg, var(--gold-deep) 0%, var(--gold-base) 22%, var(--gold-light) 45%, var(--gold-bright) 65%, var(--gold-shadow) 100%);
    color: #2d1a05;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0.6rem 1.2rem color-mix(in srgb, var(--gold-base) 35%, transparent);
