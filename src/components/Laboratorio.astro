<script type="module">
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

  const STORAGE_KEY = 'chess_custom_color_config';

  const defaultChessConfig = {
    pieces: {
      Blancas: '#efece7',
      Negras: '#1f1f1f'
    },
    board: {
      Blancas: '#f3f3f3',
      Negras: '#1f1f1f'
    }
  };

  const loadSavedState = () => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        return {
          pieces: {
            Blancas: parsed.pieces?.Blancas || defaultChessConfig.pieces.Blancas,
            Negras: parsed.pieces?.Negras || defaultChessConfig.pieces.Negras
          },
          board: {
            Blancas: parsed.board?.Blancas || defaultChessConfig.board.Blancas,
            Negras: parsed.board?.Negras || defaultChessConfig.board.Negras
          }
        };
      }
    } catch (e) {
      console.warn('No se pudo acceder a localStorage', e);
    }
    return {
      pieces: { ...defaultChessConfig.pieces },
      board: { ...defaultChessConfig.board }
    };
  };

  const chessConfig = loadSavedState();
  let activePieceTeam = 'Blancas'; // 'Blancas' | 'Negras'

  const saveState = () => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(chessConfig));
    } catch (e) {
      console.warn('No se pudo guardar en localStorage', e);
    }
  };

  const mount = document.querySelector('.model-showcase__viewer');
  const showcaseLayout = document.querySelector('.model-showcase__layout');
  const continueButton = document.querySelector('.model-showcase__continue');
  const backButton = document.querySelector('.model-showcase__back');
  const editor = document.querySelector('.model-showcase__editor');
  const colorPicker = document.querySelector('#piece-color-picker');
  const colorPickerPanel = document.querySelector('.model-color-picker');
  const colorPickerToggle = document.querySelector('.model-color-toggle');
  const colorSwatches = document.querySelectorAll('.color-swatch');
  const reloadButton = document.querySelector('.model-reload-button');
  const whiteSquaresColorPicker = document.querySelector('#white-squares-color-picker');
  const blackSquaresColorPicker = document.querySelector('#black-squares-color-picker');
  const groupColorControls = document.querySelector('.group-color-controls');
  const themeButtons = document.querySelectorAll('.theme-option');
  const pieceNav = document.querySelector('.model-showcase__piece-nav');
  const pieceNavButtons = document.querySelectorAll('.piece-nav-button');
  const groupColorInputs = document.querySelectorAll('.group-color-picker input');
  const boardColorPalettes = document.querySelectorAll('.board-color-palette');
  const matchPiecesBtn = document.querySelector('#match-pieces-btn');
  const boardColorToggles = document.querySelectorAll('.board-color-toggle');
  const modelName = document.querySelector('.model-showcase__model-name');
  const pieceTeamButtons = document.querySelectorAll('.piece-team-btn');
  const pieceTeamControls = document.querySelector('.piece-team-controls');
  const finalContainer = document.querySelector('#final-model-container');
  const viewerModeLabel = document.querySelector('#viewer-mode-label');

  boardColorToggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const panel = toggle.closest<HTMLElement>('.group-color-picker');
      if (!panel) return;
      const isCollapsed = panel.classList.toggle('is-collapsed');
      toggle.setAttribute('aria-expanded', String(!isCollapsed));
      toggle.setAttribute('aria-label', isCollapsed ? 'Desplegar selector de color' : 'Colapsar selector de color');
    });
  });

  colorPickerToggle?.addEventListener('click', () => {
    if (!colorPickerPanel || !colorPickerToggle) return;
    const isCollapsed = colorPickerPanel.classList.toggle('is-collapsed');
    colorPickerToggle.setAttribute('aria-expanded', String(!isCollapsed));
    colorPickerToggle.setAttribute('aria-label', isCollapsed ? 'Desplegar selector de color' : 'Colapsar selector de color');
  });

  // Summary dots in final preview
  const updateSummaryDots = () => {
    const dotPieceWhite = document.querySelector('#final-dot-white-piece');
    const dotPieceBlack = document.querySelector('#final-dot-black-piece');
    const dotBoardWhite = document.querySelector('#final-dot-white-board');
    const dotBoardBlack = document.querySelector('#final-dot-black-board');

    if (dotPieceWhite) dotPieceWhite.style.backgroundColor = chessConfig.pieces.Blancas;
    if (dotPieceBlack) dotPieceBlack.style.backgroundColor = chessConfig.pieces.Negras;
    if (dotBoardWhite) dotBoardWhite.style.backgroundColor = chessConfig.board.Blancas;
    if (dotBoardBlack) dotBoardBlack.style.backgroundColor = chessConfig.board.Negras;
  };

  updateSummaryDots();

  // Initialize form controls with current state
  if (colorPicker) colorPicker.value = chessConfig.pieces[activePieceTeam];
  if (whiteSquaresColorPicker) whiteSquaresColorPicker.value = chessConfig.board.Blancas;
  if (blackSquaresColorPicker) blackSquaresColorPicker.value = chessConfig.board.Negras;

  const syncColorSwatches = () => {
    colorSwatches.forEach((swatch) => {
      swatch.classList.toggle('is-selected', swatch.dataset.color === colorPicker?.value);
    });
  };

  const paletteColors = Array.from(colorSwatches)
    .map((swatch) => swatch.dataset.color)
    .filter(Boolean);

  boardColorPalettes.forEach((palette) => {
    for (let columnIndex = 0; columnIndex < 7; columnIndex += 1) {
      const column = document.createElement('div');
      column.className = 'color-palette__column';
      column.setAttribute('aria-label', `Familia de color ${columnIndex + 1}`);

      paletteColors.slice(columnIndex * 6, columnIndex * 6 + 6).forEach((color) => {
        const swatch = document.createElement('button');
        swatch.type = 'button';
        swatch.className = 'color-swatch';
        swatch.dataset.color = color;
        swatch.style.setProperty('--swatch', color);
        swatch.setAttribute('aria-label', `Elegir ${color}`);
        column.appendChild(swatch);
      });

      palette.appendChild(column);
    }
  });

  const syncBoardSwatches = () => {
    boardColorPalettes.forEach((palette) => {
      const target = palette.dataset.target;
      const input = document.querySelector(`[data-target="${target}"]`);
      palette.querySelectorAll('.color-swatch').forEach((swatch) => {
        swatch.classList.toggle('is-selected', swatch.dataset.color === input?.value);
      });
    });
  };

  const pieceModels = ['/caballo.glb', '/alfil.glb', '/reina.glb', '/torre.glb', '/peon.glb', '/rey.glb'];
  let currentPieceIndex = 0;
  let modelRoot = null;
  let currentScene = null;
  let currentRenderer = null;
  let currentCamera = null;
  let currentControls = null;
  let activeModelMode = 'piece';
  const modelCache = new Map();

  // Final 3D Scene variables
  let finalScene = null;
  let finalRenderer = null;
  let finalCamera = null;
  let finalControls = null;
  let finalModelRoot = null;
  let finalAnimationFrame = null;

  const ensureScene = () => {
    if (!mount || currentScene) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x081a1d);
    currentScene = scene;

    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);
    camera.position.set(0, 2.1, 8);
    currentCamera = camera;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(mount.clientWidth, mount.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    currentRenderer = renderer;
    mount.appendChild(renderer.domElement);

    const ambient = new THREE.AmbientLight(0xffffff, 1.4);
    scene.add(ambient);

    const directional = new THREE.DirectionalLight(0xffffff, 1.8);
    directional.position.set(8, 10, 6);
    scene.add(directional);

    const fillLight = new THREE.DirectionalLight(0x9fc5e8, 1.0);
    fillLight.position.set(-6, 6, -4);
    scene.add(fillLight);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.enablePan = false;
    controls.enableZoom = true;
    controls.minDistance = 2;
    controls.maxDistance = 40;
    currentControls = controls;

    const resize = () => {
      const width = mount.clientWidth;
      const height = mount.clientHeight;
      if (width === 0 || height === 0) return;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    window.addEventListener('resize', resize);
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(mount);
    resize();

    const tick = () => {
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    };

    tick();
  };

  const cloneModelWithMaterials = (source) => {
    const clone = source.clone(true);
    clone.traverse((child) => {
      if (child.isMesh && child.material) {
        child.material = Array.isArray(child.material)
          ? child.material.map((m) => m.clone())
          : child.material.clone();
      }
    });
    return clone;
  };

  const applyMeshColor = (child, targetColor) => {
    if (!child.isMesh) return;
    if (child.material) {
      const materials = Array.isArray(child.material) ? child.material : [child.material];
      materials.forEach((mat) => {
        if (mat.color) {
          mat.color.set(targetColor);
        }
        mat.needsUpdate = true;
      });
    } else {
      child.material = new THREE.MeshStandardMaterial({
        color: new THREE.Color(targetColor),
        metalness: 0.15,
        roughness: 0.8
      });
    }
  };

  const applyBoardColors = (object) => {
    if (!object) return;
    object.traverse((child) => {
      if (!child.isMesh) return;
      const meshName = (child.name || '').toLowerCase();
      const parentName = (child.parent?.name || '').toLowerCase();

      const isBlackSquare = meshName === 'negras' || meshName.includes('negra') || meshName.includes('black');
      const targetColor = isBlackSquare ? chessConfig.board.Negras : chessConfig.board.Blancas;

      applyMeshColor(child, targetColor);
    });
  };

  const updateCurrentPieceColor = () => {
    const targetColor = chessConfig.pieces[activePieceTeam];
    if (colorPicker) colorPicker.value = targetColor;
    syncColorSwatches();

    if (modelRoot && activeModelMode === 'piece') {
      modelRoot.traverse((child) => {
        applyMeshColor(child, targetColor);
      });
    }

    updateSummaryDots();
    if (finalModelRoot) {
      applyFinalModelColors(finalModelRoot);
    }
  };

  const applyFinalModelColors = (model) => {
    if (!model) return;

    model.traverse((child) => {
      if (!child.isMesh) return;

      const name = (child.name || '').toLowerCase();
      const parentName = (child.parent?.name || '').toLowerCase();
      const uName = (child.userData?.name || '').toLowerCase();

      // Check hierarchy for collection keywords
      let cur = child.parent;
      let hierarchy = '';
      while (cur) {
        hierarchy += ' ' + (cur.name || '');
        cur = cur.parent;
      }
      hierarchy = hierarchy.toLowerCase();

      let targetColor = chessConfig.pieces.Blancas;

      const isBoard =
        name.includes('plane') ||
        parentName.includes('blancas') ||
        name === 'negras' ||
        hierarchy.includes('tablero') ||
        hierarchy.includes('board') ||
        name.includes('board') ||
        name.includes('tablero');

      if (isBoard) {
        const isBlackSquare =
          name === 'negras' ||
          name.includes('negra') ||
          name.includes('black') ||
          name.includes('oscur') ||
          hierarchy.includes('negra') ||
          hierarchy.includes('black');

        targetColor = isBlackSquare ? chessConfig.board.Negras : chessConfig.board.Blancas;
      } else {
        // Piece classification
        const isBlackPieceCollection =
          hierarchy.includes('piezas negras') ||
          hierarchy.includes('piezas_negras') ||
          hierarchy.includes('black_pieces') ||
          parentName.includes('piezas negras') ||
          parentName.includes('piezas_negras');

        const isWhitePieceCollection =
          hierarchy.includes('piezas blancas') ||
          hierarchy.includes('piezas_blancas') ||
          hierarchy.includes('white_pieces') ||
          parentName.includes('piezas blancas') ||
          parentName.includes('piezas_blancas');

        if (isBlackPieceCollection) {
          targetColor = chessConfig.pieces.Negras;
        } else if (isWhitePieceCollection) {
          targetColor = chessConfig.pieces.Blancas;
        } else {
          // Identify by .001 / 001 name suffix or negative Z coordinate in chessboard layout
          const has001 = name.includes('001') || uName.includes('001') || name.includes('negra') || name.includes('black');
          const isNegativeZ = child.position.z < -0.005;

          if (has001 || isNegativeZ) {
            targetColor = chessConfig.pieces.Negras;
          } else {
            targetColor = chessConfig.pieces.Blancas;
          }
        }
      }

      applyMeshColor(child, targetColor);
      child.castShadow = true;
      child.receiveShadow = true;
    });
  };

  const ensureFinalScene = () => {
    if (!finalContainer) return;
    if (finalScene) {
      if (finalRenderer && finalCamera) {
        finalRenderer.setSize(finalContainer.clientWidth, finalContainer.clientHeight);
        finalCamera.aspect = finalContainer.clientWidth / (finalContainer.clientHeight || 1);
        finalCamera.updateProjectionMatrix();
      }
      if (finalModelRoot) {
        applyFinalModelColors(finalModelRoot);
      }
      finalRenderer.render(finalScene, finalCamera);
      return;
    }

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060f12);
    finalScene = scene;

    const camera = new THREE.PerspectiveCamera(38, finalContainer.clientWidth / (finalContainer.clientHeight || 1), 0.1, 1000);
    camera.position.set(0, 6.5, 8.5);
    finalCamera = camera;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(finalContainer.clientWidth, finalContainer.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    finalRenderer = renderer;
    finalContainer.appendChild(renderer.domElement);

    const ambient = new THREE.AmbientLight(0xffffff, 1.4);
    scene.add(ambient);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 1.8);
    dirLight1.position.set(8, 12, 6);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x9fc5e8, 1.0);
    dirLight2.position.set(-8, 6, -6);
    scene.add(dirLight2);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.enablePan = false;
    controls.enableZoom = true;
    controls.minDistance = 3;
    controls.maxDistance = 30;
    controls.target.set(0, 0.8, 0);
    finalControls = controls;

    const resizeFinal = () => {
      if (!finalContainer || !finalRenderer || !finalCamera) return;
      const width = finalContainer.clientWidth;
      const height = finalContainer.clientHeight;
      if (width === 0 || height === 0) return;
      finalRenderer.setSize(width, height);
      finalCamera.aspect = width / height;
      finalCamera.updateProjectionMatrix();
    };

    window.addEventListener('resize', resizeFinal);

    const tick = () => {
      controls.update();
      renderer.render(scene, camera);
      finalAnimationFrame = requestAnimationFrame(tick);
    };

    tick();

    const fallback = finalContainer.querySelector('.final-model-fallback');
    const loader = new GLTFLoader();

    loader.load(
      '/resultadofinal.glb',
      (gltf) => {
        finalModelRoot = gltf.scene;

        finalModelRoot.position.set(0, 0, 0);
        finalModelRoot.rotation.set(0, 0, 0);
        finalModelRoot.scale.set(1, 1, 1);
        finalModelRoot.updateMatrixWorld(true);

        const box = new THREE.Box3().setFromObject(finalModelRoot);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());

        finalModelRoot.position.x -= center.x;
        finalModelRoot.position.y -= box.min.y;
        finalModelRoot.position.z -= center.z;

        const maxDim = Math.max(size.x, size.y, size.z) || 1;
        finalModelRoot.scale.setScalar(5.2 / maxDim);
        finalModelRoot.rotation.y = -0.5;

        applyFinalModelColors(finalModelRoot);
        scene.add(finalModelRoot);

        if (fallback) fallback.remove();
        resizeFinal();
        controls.enabled = false;
        controls.enableRotate = false;
        controls.enableZoom = false;
        controls.enablePan = false;
        if (finalAnimationFrame !== null) {
          cancelAnimationFrame(finalAnimationFrame);
          finalAnimationFrame = null;
        }
        renderer.render(scene, camera);
      },
      undefined,
      (error) => {
        console.warn('resultadofinal.glb no se pudo cargar:', error);
        if (fallback) {
          fallback.innerHTML = 'Coloca <strong>resultadofinal.glb</strong> en la carpeta <code>public/</code> para visualizar el tablero completo aquí.';
        }
      }
    );
  };

  const reloadFinalScene = () => {
    if (!finalContainer) return;

    if (finalAnimationFrame !== null) {
      cancelAnimationFrame(finalAnimationFrame);
      finalAnimationFrame = null;
    }

    finalControls?.dispose();
    finalScene?.traverse((child) => {
      if (!child.isMesh) return;
      child.geometry?.dispose();
      const materials = Array.isArray(child.material) ? child.material : [child.material];
      materials.forEach((material) => material?.dispose());
    });
    finalRenderer?.dispose();
    finalRenderer?.domElement.remove();

    finalScene = null;
    finalRenderer = null;
    finalCamera = null;
    finalControls = null;
    finalModelRoot = null;

    if (!finalContainer.querySelector('.final-model-fallback')) {
      const fallback = document.createElement('div');
      fallback.className = 'final-model-fallback';
      fallback.textContent = 'Cargando resultado final...';
      finalContainer.appendChild(fallback);
    }

    ensureFinalScene();
  };

  reloadButton?.addEventListener('click', () => {
    reloadButton.setAttribute('disabled', 'true');
    reloadFinalScene();
    window.setTimeout(() => reloadButton.removeAttribute('disabled'), 1200);
  });

  continueButton?.addEventListener('click', () => {
    if (!mount || !showcaseLayout || showcaseLayout.classList.contains('is-revealed')) return;

    showcaseLayout.classList.add('is-revealed');
    continueButton.setAttribute('aria-expanded', 'true');
    backButton?.setAttribute('aria-hidden', 'false');
    editor?.setAttribute('aria-hidden', 'false');

    setTimeout(() => {
      ensureFinalScene();
      if (finalModelRoot) {
        applyFinalModelColors(finalModelRoot);
      }
    }, 250);
  });

  backButton?.addEventListener('click', () => {
    if (!mount || !showcaseLayout || !showcaseLayout.classList.contains('is-revealed')) return;

    const layoutTransition = showcaseLayout.style.transition;
    const viewerTransition = mount.style.transition;
    showcaseLayout.style.transition = 'none';
    mount.style.transition = 'none';
    showcaseLayout.classList.remove('is-revealed');
    continueButton?.setAttribute('aria-expanded', 'false');
    backButton?.setAttribute('aria-hidden', 'true');
    editor?.setAttribute('aria-hidden', 'true');

    requestAnimationFrame(() => {
      showcaseLayout.style.transition = layoutTransition;
      mount.style.transition = viewerTransition;
    });
  });

  matchPiecesBtn?.addEventListener('click', () => {
    chessConfig.board.Blancas = chessConfig.pieces.Blancas;
    chessConfig.board.Negras = chessConfig.pieces.Negras;
    if (whiteSquaresColorPicker) whiteSquaresColorPicker.value = chessConfig.board.Blancas;
    if (blackSquaresColorPicker) blackSquaresColorPicker.value = chessConfig.board.Negras;
    saveState();

    syncBoardSwatches();

    if (modelRoot && activeModelMode === 'board') {
      applyBoardColors(modelRoot);
    }

    updateSummaryDots();
    if (finalModelRoot) applyFinalModelColors(finalModelRoot);
  });

  // Team Selector (Blancas / Negras)
  pieceTeamButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const team = btn.dataset.team;
      if (!team) return;
      activePieceTeam = team;

      pieceTeamButtons.forEach((b) => b.classList.toggle('is-active', b.dataset.team === activePieceTeam));
      updateCurrentPieceColor();
    });
  });

  groupColorInputs.forEach((input) => {
    ['input', 'change'].forEach((eventType) => {
      input.addEventListener(eventType, (event) => {
        const targetName = event.target.dataset.target;
        if (!targetName) return;

        chessConfig.board[targetName] = event.target.value;
        saveState();

        if (activeModelMode === 'board' && modelRoot) {
          applyBoardColors(modelRoot);
        }

        updateSummaryDots();
        if (finalModelRoot) applyFinalModelColors(finalModelRoot);
      });
    });
  });

  boardColorPalettes.forEach((palette) => {
    palette.addEventListener('click', (event) => {
      const swatch = event.target.closest('.color-swatch');
      const targetName = palette.dataset.target;
      const nextColor = swatch?.dataset.color;
      const input = document.querySelector(`[data-target="${targetName}"]`);
      if (!targetName || !nextColor || !input) return;

      input.value = nextColor;
      chessConfig.board[targetName] = nextColor;
      saveState();

      if (activeModelMode === 'board' && modelRoot) {
        applyBoardColors(modelRoot);
      }

      updateSummaryDots();
      if (finalModelRoot) applyFinalModelColors(finalModelRoot);
      syncBoardSwatches();
    });
  });

  syncBoardSwatches();

  const syncThemeButtons = () => {
    themeButtons.forEach((button) => {
      const isPieceButton = button.dataset.mode === 'piece';
      const isBoardButton = button.dataset.mode === 'board';
      const isActive = activeModelMode === 'piece' ? isPieceButton : isBoardButton;
      button.classList.toggle('is-active', isActive);
      button.style.transform = isActive ? 'translateY(-2px) scale(1.01)' : 'translateY(0)';

      if (viewerModeLabel) {
        viewerModeLabel.textContent = activeModelMode === 'piece' ? 'Piezas' : 'Tableros';
      }
    });
  };

  const updateControlsVisibility = () => {
    if (colorPicker) {
      colorPicker.closest('.model-showcase__controls').style.display = activeModelMode === 'piece' ? 'flex' : 'none';
      if (activeModelMode === 'piece') {
        colorPicker.value = chessConfig.pieces[activePieceTeam];
      }
    }
    if (pieceTeamControls) {
      pieceTeamControls.style.display = activeModelMode === 'piece' ? 'inline-flex' : 'none';
    }
    if (groupColorControls) {
      groupColorControls.style.display = activeModelMode === 'board' ? 'flex' : 'none';
    }
    if (pieceNav) {
      pieceNav.classList.toggle('is-visible', activeModelMode === 'piece');
    }
    syncThemeButtons();
  };

  const prepareModelObject = (object, isBoard) => {
    object.position.set(0, 0, 0);
    object.rotation.set(0, 0, 0);
    object.scale.set(1, 1, 1);
    object.rotation.y = isBoard ? -0.8 : -1.6;
    object.updateMatrixWorld(true);

    const box = new THREE.Box3().setFromObject(object);
    const size = box.getSize(new THREE.Vector3());

    const maxDim = Math.max(size.x, size.y, size.z) || 1;
    const targetSize = isBoard ? maxDim : size.y || 1;
    const scale = (isBoard ? 3.6 : 4.2) / targetSize;
    object.scale.setScalar(scale);
    object.updateMatrixWorld(true);

    const centeredBox = new THREE.Box3().setFromObject(object);
    const centered = centeredBox.getCenter(new THREE.Vector3());
    object.position.x -= centered.x;
    if (isBoard) {
      object.position.y -= centered.y;
      object.position.y += -1.4;
    } else {
      object.position.y -= centeredBox.min.y;
      object.position.y += 1.1;
    }
    object.position.z -= centered.z;

    if (isBoard) {
      applyBoardColors(object);
    } else {
      const targetColor = chessConfig.pieces[activePieceTeam];
      object.traverse((child) => {
        applyMeshColor(child, targetColor);
      });
    }

    return object;
  };

  const updateCameraForMode = (isBoard) => {
    if (!currentControls || !currentCamera) return;
    const targetY = isBoard ? -0.5 : 3.2;
    const camX = isBoard ? 0 : 4.8;
    const camY = isBoard ? 4.5 : 5.4;
    const camZ = isBoard ? 8.5 : 9.2;

    currentControls.target.set(0, targetY, 0);
    currentCamera.position.set(camX, camY, camZ);
    currentControls.update();
  };

  const loadModel = (modelUrl) => {
    if (!mount) return;

    activeModelMode = modelUrl.includes('tablero') ? 'board' : 'piece';
    if (modelName) {
      modelName.textContent = modelUrl.includes('rey.glb')
        ? 'Rey'
        : modelUrl.includes('alfil.glb')
          ? 'Alfil'
          : modelUrl.includes('reina.glb')
            ? 'Reina'
            : modelUrl.includes('torre.glb')
              ? 'Torre'
              : modelUrl.includes('peon.glb')
                ? 'Peón'
                : 'Caballo';
      modelName.hidden = activeModelMode !== 'piece';
    }
    if (activeModelMode === 'piece') {
      const index = pieceModels.indexOf(modelUrl);
      if (index >= 0) currentPieceIndex = index;
    }
    updateControlsVisibility();
    ensureScene();

    const fallback = mount.querySelector('.model-fallback');
    const isBoard = activeModelMode === 'board';

    if (modelRoot && currentScene) {
      currentScene.remove(modelRoot);
      modelRoot = null;
    }

    const cached = modelCache.get(modelUrl);
    if (cached) {
      const object = cloneModelWithMaterials(cached);
      modelRoot = prepareModelObject(object, isBoard);
      currentScene.add(modelRoot);
      if (fallback) fallback.remove();
      updateCameraForMode(isBoard);
      return;
    }

    const loader = new GLTFLoader();
    loader.load(
      modelUrl,
      (gltf) => {
        const rawScene = gltf.scene;
        modelCache.set(modelUrl, rawScene);

        const object = prepareModelObject(cloneModelWithMaterials(rawScene), isBoard);
        modelRoot = object;
        currentScene.add(modelRoot);

        if (fallback) fallback.remove();
        updateCameraForMode(isBoard);
      },
      undefined,
      (error) => {
        console.error('No se pudo cargar el modelo 3D:', error);
        if (fallback) {
          fallback.textContent = 'No se pudo cargar el modelo';
        }
      }
    );
  };

  const navigatePiece = (direction) => {
    if (activeModelMode !== 'piece') return;
    currentPieceIndex = (currentPieceIndex + direction + pieceModels.length) % pieceModels.length;
    const nextModel = pieceModels[currentPieceIndex];
    loadModel(nextModel);
  };

  pieceNavButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const direction = Number(button.dataset.direction || 0);
      navigatePiece(direction);
    });
  });

  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedMode = button.dataset.mode;

      if (selectedMode === 'board') {
        loadModel('/tablero.glb');
        return;
      }

      loadModel(pieceModels[currentPieceIndex]);

      if (groupColorControls) {
        groupColorControls.style.display = 'none';
      }
    });
  });

  const modelUrl = mount?.dataset.modelSrc || pieceModels[0];
  currentPieceIndex = pieceModels.indexOf(modelUrl) >= 0 ? pieceModels.indexOf(modelUrl) : 0;
  updateControlsVisibility();
  loadModel(modelUrl);

  ['input', 'change'].forEach((eventType) => {
    colorPicker?.addEventListener(eventType, (event) => {
      const nextColor = event.target.value;
      chessConfig.pieces[activePieceTeam] = nextColor;
      saveState();
      updateCurrentPieceColor();
    });
  });

  colorSwatches.forEach((swatch) => {
    swatch.addEventListener('click', () => {
      const nextColor = swatch.dataset.color;
      if (!nextColor || !colorPicker) return;
      colorPicker.value = nextColor;
      chessConfig.pieces[activePieceTeam] = nextColor;
      saveState();
      updateCurrentPieceColor();
    });
  });

  syncColorSwatches();
</script>
