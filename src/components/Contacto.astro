---
const {
  title = '¿QUERÉS SABER MÁS?',
  subtitle = 'Escribínos para conocer valores, colores disponibles y modelos de nuestros juegos.',
  imageSrc = 'https://res.cloudinary.com/lp0nhnzi/image/upload/v1789705399/IMG_0676_PS_02.png'
} = Astro.props;
---

<section id="partidas" class="contacto-section" style={`--contact-image: url("${imageSrc}")`} aria-label="Sección de contacto">
  <div class="contacto__inner">
    <div class="contacto__content">
      <div class="contacto__divider" aria-hidden="true"></div>

      <p class="contacto__eyebrow">Contacto</p>

      <div class="contacto__header">
        <h2>{title}</h2>
        <p>{subtitle}</p>
      </div>

      <div class="contacto__details">
        <h3>Consultá por tu juego</h3>
        <p>Te contamos todo lo que necesitás saber sobre nuestros juegos disponibles.</p>
      </div>

      <a
        href="https://ig.me/m/vavchesslab"
        class="contacto__button"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
					<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
					<circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
        </svg>
        <span>Contactar</span>
      </a>
      <a
        href="mailto:vavlaboratory@gmail.com"
        class="email__button"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M3 8L8.44992 11.6333C9.73295 12.4886 10.3745 12.9163 11.0678 13.0825C11.6806 13.2293 12.3194 13.2293 12.9322 13.0825C13.6255 12.9163 14.2671 12.4886 15.5501 11.6333L21 8M6.2 19H17.8C18.9201 19 19.4802 19 19.908 18.782C20.2843 18.5903 20.5903 18.2843 20.782 17.908C21 17.4802 21 16.9201 21 15.8V8.2C21 7.0799 21 6.51984 20.782 6.09202C20.5903 5.71569 20.2843 5.40973 19.908 5.21799C19.4802 5 18.9201 5 17.8 5H6.2C5.0799 5 4.51984 5 4.09202 5.21799C3.71569 5.40973 3.40973 5.71569 3.21799 6.09202C3 6.51984 3 7.07989 3 8.2V15.8C3 16.9201 3 17.4802 3.21799 17.908C3.40973 18.2843 3.71569 18.5903 4.09202 18.782C4.51984 19 5.07989 19 6.2 19Z" stroke="#e8c031" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
        <span>Enviar email</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    color: var(--foreground, #ffffff);
  }

  .contacto-section::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: #27010e;
    background-image: var(--contact-image);
    background-position: left center;
    background-size: contain;
    background-repeat: no-repeat;
    content: '';
  }

  .contacto-section::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.02) 0%,
      rgba(0, 0, 0, 0.05) 18%,
      rgba(0, 0, 0, 0.16) 30%,
      rgba(0, 0, 0, 0.38) 42%,
      rgba(0, 0, 0, 0.68) 54%,
      rgba(0, 0, 0, 0.9) 66%,
      rgba(0, 0, 0, 0.98) 78%,
      #000 100%
    );
    content: '';
  }

  .contacto__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.82fr);
    align-items: center;
    padding: 5rem clamp(1.5rem, 3vw, 3rem);
  }

  .contacto__content {
    grid-column: 2;
    width: min(100%, 23rem);
    margin-left: auto;
    margin-right: 6rem;
    margin-bottom: 3rem;
    padding: 1rem 0;
  }

  .contacto__eyebrow {
    margin: 0 0 1rem;
    color: #e8c031;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contacto__header h2 {
    max-width: none;
    color: #fff;
    font-size: clamp(1.8rem, 2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 2.8rem;
    white-space: nowrap;
  }

  .contacto__header p,
  .contacto__details p {
    color: rgba(255, 255, 255, 0.67);
    font-size: 1rem;
    line-height: 1.55;
  }

  .contacto__header p {
    max-width: 22rem;
    margin: 2rem 0 0;
  }

  .contacto__divider {
    width: 3.5rem;
    height: 2px;
    margin: 0 0 1.75rem;
    background: rgba(255, 255, 255, 0.3);
  }

  .contacto__details h3 {
    margin: 0;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .contacto__details p {
    max-width: 24rem;
    margin: 0.5rem 0 1.45rem;
    font-size: 0.92rem;
  }

  .contacto__button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.78rem 1.55rem;
    border-radius: 999px;
    color: #2e2e2e;
    background: #e8c031;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .contacto__button:hover {
    background: #f2d15a;
    transform: translateY(-2px);
  }

  .contacto__button svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .email__button {
    display: inline-flex;
    align-items: center;
    margin-left: 1rem;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.78rem 1.55rem;
    border-radius: 999px;
    border: 1px solid #e8c031;
    color: #e8c031;
    background: rgba(27, 27, 27, 0.4);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .email__button:hover {
    background: rgba(27, 27, 27, 0.4);
    transform: translateY(-2px);
  }

  .email__button svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (max-width: 768px) {
    .contacto-section {
      min-height: 75vh;
      min-height: 58svh;
    }

    .contacto-section::after {
      background: rgba(0, 0, 0, 0.6);
    }

    .contacto-section::before {
      background-size: contain;
    }

    .contacto__inner {
      display: flex;
      align-items: flex-start;
      padding: 1.5rem 1.5rem 3rem;
    }

    .contacto__content {
      width: 100%;
      margin: 0;
      padding: 2rem 0 0;
      text-align: center;
    }

    .contacto__eyebrow {
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: 0.22em;
    }

    .contacto__header h2 {
      font-size: 1.5rem;
      line-height: 1.2;
      white-space: normal;
    }

    .contacto__header p,
    .contacto__details p {
      margin-right: auto;
      margin-left: auto;
    }

    .contacto__divider {
      margin: 0 auto 1.5rem;
    }

    .contacto__details {
      display: none;
    }

    .contacto__button {
      display: flex;
      width: min(60%, 14rem);
      box-sizing: border-box;
      margin: 1.75rem auto 0;
      justify-content: center;
    }

    .email__button {
      display: flex;
      width: min(60%, 14rem);
      box-sizing: border-box;
      margin: 1.75rem auto 0;
      justify-content: center;
    }
  }

  @media (max-aspect-ratio: 3 / 2) {
    .contacto-section::before {
      background-size: cover;
      background-position: left center;
    }
  }

  @media (min-width: 769px) and (max-width: 1100px) {
    .contacto-section {
      min-height: 0;
    }

    .contacto__inner {
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      padding: 1.5rem 3rem 3rem;
    }

    .contacto__content {
      margin: 0;
      padding: 0;
    }
  }
</style>
