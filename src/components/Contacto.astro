---
const {
  title = '¿QUERÉS SABER MÁS?',
  subtitle = 'Escribínos para conocer valores, colores disponibles y modelos de nuestros juegos.',
  imageSrc = 'https://res.cloudinary.com/lp0nhnzi/image/upload/v1789705399/IMG_0676_PS_02.png'
} = Astro.props;
---

<section id="partidas" class="contacto-section" style={`--contact-image: url("${imageSrc}")`} aria-label="Sección de contacto">
  <div class="contacto__inner">
    <div class="contacto__content">
      <p class="contacto__eyebrow">Contacto</p>

      <div class="contacto__header">
        <h2>{title}</h2>
        <p>{subtitle}</p>
      </div>

      <div class="contacto__divider" aria-hidden="true"></div>

      <div class="contacto__details">
        <h3>Consultá por tu juego</h3>
        <p>Te contamos todo lo que necesitás saber sobre nuestros juegos disponibles.</p>
      </div>

      <a
        href="https://ig.me/m/vavchesslab"
        target="_blank"
        rel="noopener noreferrer"
        class="contacto__button"
      >
        <span>Contactar</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    color: var(--foreground, #ffffff);
  }

  .contacto-section::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: #27010e;
    background-image: var(--contact-image);
    background-position: left center;
    background-size: contain;
    background-repeat: no-repeat;
    content: '';
  }

  .contacto-section::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.02) 0%,
      rgba(0, 0, 0, 0.05) 18%,
      rgba(0, 0, 0, 0.16) 30%,
      rgba(0, 0, 0, 0.38) 42%,
      rgba(0, 0, 0, 0.68) 54%,
      rgba(0, 0, 0, 0.9) 66%,
      rgba(0, 0, 0, 0.98) 78%,
      #000 100%
    );
    content: '';
  }

  .contacto__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.82fr);
    align-items: center;
    padding: 5rem clamp(1.5rem, 3vw, 3rem);
  }

  .contacto__content {
    grid-column: 2;
    width: min(100%, 23rem);
    margin-left: auto;
    margin-right: 6rem;
    margin-bottom: 3rem;
    padding: 1rem 0;
  }

  .contacto__eyebrow {
    margin: 0 0 1rem;
    color: #e8c031;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contacto__header h2 {
    max-width: none;
    color: #fff;
    font-size: clamp(1.8rem, 2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 2.8rem;
    white-space: nowrap;
  }

  .contacto__header p,
  .contacto__details p {
    color: rgba(255, 255, 255, 0.67);
    font-size: 1rem;
    line-height: 1.55;
  }

  .contacto__header p {
    max-width: 22rem;
    margin: 1rem 0 0;
  }

  .contacto__divider {
    width: 3.5rem;
    height: 1px;
    margin: 2.8rem 0 2.45rem;
    background: rgba(255, 255, 255, 0.3);
  }

  .contacto__details h3 {
    margin: 0;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .contacto__details p {
    max-width: 24rem;
    margin: 0.5rem 0 1.45rem;
    font-size: 0.92rem;
  }

  .contacto__button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.78rem 1.55rem;
    border-radius: 999px;
    color: #2e2e2e;
    background: #e8c031;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .contacto__button:hover {
    background: #f2d15a;
    transform: translateY(-2px);
  }

  .contacto__button svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (max-width: 768px) {
    .contacto-section {
      min-height: 100vh;
      min-height: 100svh;
    }

    .contacto-section::after {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.04) 0%,
        rgba(0, 0, 0, 0.28) 38%,
        rgba(0, 0, 0, 0.94) 72%,
        rgba(0, 0, 0, 0.98) 100%
      );
    }

    .contacto-section::before {
      background-size: contain;
    }

    .contacto__inner {
      display: flex;
      align-items: flex-end;
      padding: 3rem 1.5rem;
    }

    .contacto__content {
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .contacto__header h2 {
      font-size: 1.8rem;
    }
  }
</style>
