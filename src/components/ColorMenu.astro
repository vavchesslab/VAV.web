---
const { activeColor, basePath = '/Index' } = Astro.props;
---

<details class="color-menu">
	<summary title="Cambiar color" aria-label="Cambiar color">
		<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
			<path d="m14.5 3.5 6 6M13 5l6 6-8.5 8.5H5v-5.5L11.5 7M5 19l-3 3M15 3l2-2 6 6-2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</summary>
	<div class="color-menu-options">
		<a class:list={{ active: activeColor === '1' }} href={`${basePath}/1`}>Color1</a>
		<a class:list={{ active: activeColor === '2' }} href={`${basePath}/2`}>Color2</a>
		<a class:list={{ active: activeColor === '3' }} href={`${basePath}/3`}>Color3</a>
	</div>
</details>