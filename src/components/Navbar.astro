---
const { showVersionToggle = false } = Astro.props;
---

<header class="sticky-nav-header">
	<nav class="nav-divider is-visible mx-auto max-w-[1600px] px-6 py-4">
		<div class="version-two-brand">
			<a class="flex items-center gap-3 font-semibold tracking-tight" href="#home">
				<span class="navbar-logo-wrap">
					<img id="logo" src="https://res.cloudinary.com/du83pwamg/image/upload/v1788372944/VAV_BorderWH_omznb8.png" alt="VAV Logo" class="pb-2 h-12 w-auto">
					<img src="https://res.cloudinary.com/du83pwamg/image/upload/v1788372944/VAV_BorderWH_omznb8.png" alt="" aria-hidden="true" class="navbar-logo-gold pb-2 h-12 w-auto">
				</span>
			</a>
		</div>
		<button class="navbar-menu-toggle" type="button" aria-label="Abrir menú" aria-controls="navbar-menu" aria-expanded="false">
			<span class="navbar-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>
		<div class="navbar-menu" id="navbar-menu" hidden>
			<div class="nav-actions">
				<a class="version-two-nav-link is-active" href="#home" data-nav="home">Home</a>
				<a class="version-two-nav-link" href="#laboratorio" data-nav="laboratorio">Laboratorio</a>
				<a class="version-two-nav-link" href="#galeria" data-nav="galeria">Galería</a>
				<a class="version-two-nav-link" href="#partidas" data-nav="partidas">Contacto</a>
				<span class="nav-active-indicator" aria-hidden="true"></span>
				{showVersionToggle && <a class="version-toggle" href="/">Volver al original</a>}
			</div>
			<button class="navbar-game-link" type="button" aria-label="Jugar partida" aria-pressed="false">
				<span>Jugar partida</span>
				<img class="navbar-board-icon" src="https://res.cloudinary.com/lp0nhnzi/image/upload/v1790182193/tablero.png" alt="" aria-hidden="true">
			</button>
		</div>
		<span class="nav-line" aria-hidden="true"></span>
	</nav>
</header>

<style>
	.sticky-nav-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		isolation: isolate;
		background: transparent;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.sticky-nav-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: rgba(12, 14, 18, 0.52);
	}

	@supports (-webkit-backdrop-filter: blur(1px)) {
		.sticky-nav-header::before {
			-webkit-backdrop-filter: blur(30px) saturate(135%);
		}
	}

	@supports (backdrop-filter: blur(1px)) {
		.sticky-nav-header::before {
			backdrop-filter: blur(30px) saturate(135%);
		}
	}

	.sticky-nav-header > nav {
		position: relative;
		z-index: 1;
	}

	.navbar-logo-wrap {
		position: relative;
		display: inline-flex;
		overflow: hidden;
	}

	.navbar-logo-gold {
		position: absolute;
		inset: 0;
		filter: brightness(0) saturate(100%) invert(76%) sepia(81%) saturate(850%) hue-rotate(3deg) brightness(96%);
		clip-path: inset(100% 0 0);
		transition: clip-path 1.2s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.version-two-brand a:hover .navbar-logo-gold,
	.version-two-brand a:focus-visible .navbar-logo-gold {
		clip-path: inset(0 0 0);
	}

	.navbar-menu-toggle {
		position: relative;
		z-index: 2;
		display: grid;
		width: 2.75rem;
		aspect-ratio: 1;
		place-items: center;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.55rem;
		color: var(--foreground);
		background: rgba(255, 255, 255, 0.06);
		cursor: pointer;
		transition: border-color 180ms ease, background 180ms ease;
	}

	.navbar-menu-toggle:hover,
	.navbar-menu-toggle:focus-visible,
	.navbar-menu-toggle[aria-expanded="true"] {
		border-color: var(--gold-base);
		background: rgba(212, 167, 44, 0.14);
		outline: none;
	}

	.navbar-menu-icon {
		display: grid;
		gap: 0.28rem;
		width: 1.15rem;
	}

	.navbar-menu-icon span {
		display: block;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.navbar-menu-toggle[aria-expanded="true"] .navbar-menu-icon span:first-child {
		transform: translateY(0.38rem) rotate(45deg);
	}

	.navbar-menu-toggle[aria-expanded="true"] .navbar-menu-icon span:nth-child(2) {
		opacity: 0;
	}

	.navbar-menu-toggle[aria-expanded="true"] .navbar-menu-icon span:last-child {
		transform: translateY(-0.38rem) rotate(-45deg);
	}

	.navbar-menu {
		position: absolute;
		top: calc(100% + 0.65rem);
		right: 1.5rem;
		z-index: 1;
		display: grid;
		width: min(18rem, calc(100vw - 3rem));
		gap: 0.7rem;
		padding: 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 0.75rem;
		background: rgba(15, 19, 22, 0.96);
		box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(24px);
	}

	.navbar-menu[hidden] {
		display: none;
	}

	.navbar-menu .nav-actions {
		position: static;
		display: grid;
		justify-self: stretch;
		gap: 0;
	}

	.navbar-menu .nav-active-indicator {
		display: none;
	}

	.navbar-menu .version-two-nav-link {
		padding: 0.85rem 0.7rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.09);
		font-size: 0.8rem;
	}

	.navbar-menu .version-two-nav-link:last-of-type {
		border-bottom: 0;
	}

	.navbar-menu .version-toggle {
		justify-self: start;
		margin-top: 0.65rem;
	}

	@media (max-width: 1279.98px) {
		.navbar-menu {
			position: fixed;
			inset: 0;
			align-content: center;
			width: 100vw;
			height: 100vh;
			height: 100dvh;
			gap: 1rem;
			overflow-y: auto;
			padding: 1rem 1.5rem 7rem;
			border: 0;
			border-radius: 0;
			background: rgba(12, 14, 18, 0.98);
			box-shadow: none;
			backdrop-filter: blur(30px);
		}

		.navbar-menu .nav-actions {
			width: min(100%, 30rem);
			margin-inline: auto;
			row-gap: 0.5rem;
		}

		.navbar-menu .version-two-nav-link {
			padding: 1rem 0.5rem;
			font-size: 1rem;
		}

		.navbar-menu .version-toggle {
			justify-self: center;
			margin: 1rem auto 0;
		}

		.navbar-menu .navbar-game-link {
			width: min(100%, 30rem);
			margin: 1rem auto 0;
		}
	}

	.navbar-board-icon {
		display: block;
		width: 2.35rem;
		height: 2.35rem;
		object-fit: contain;
	}

	.navbar-game-link {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		gap: 0.55rem;
		padding: 0.35rem 0.55rem 0.35rem 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 0.65rem;
		color: var(--foreground);
		background: rgba(255, 255, 255, 0.06);
		font-size: 0.72rem;
		font-weight: 700;
		font-family: inherit;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
	}

	.navbar-game-link:hover,
	.navbar-game-link:focus-visible {
		border-color: var(--gold-base);
		background: rgba(212, 167, 44, 0.14);
		outline: none;
		transform: translateY(-1px);
	}

	.navbar-game-link[aria-pressed="true"] {
		border-color: var(--gold-base);
		background: rgba(212, 167, 44, 0.12);
		transform: translateY(-2px);
	}

	.navbar-game-link[aria-pressed="true"] .navbar-board-icon {
		transform: translateY(-3px);
		filter: drop-shadow(0 0.55rem 0.5rem rgba(242, 201, 76, 0.9));
	}

	.navbar-board-icon {
		transition: transform 180ms ease, filter 180ms ease;
	}
</style>

<script>
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.version-two-nav-link[data-nav]');
	const sections = document.querySelectorAll<HTMLElement>('section[id]');
	const navActions = document.querySelector<HTMLElement>('.nav-actions');
	const activeIndicator = document.querySelector<HTMLElement>('.nav-active-indicator');
	const gameButton = document.querySelector<HTMLButtonElement>('.navbar-game-link');
	const menuToggle = document.querySelector<HTMLButtonElement>('.navbar-menu-toggle');
	const menu = document.querySelector<HTMLElement>('#navbar-menu');
	const heroVideo = document.querySelector<HTMLVideoElement>('.version-two-video');
	const desktopMenu = window.matchMedia('(min-width: 1280px)');
	let isMenuOpen = false;
	let isBodyScrollLocked = false;
	let menuScrollPosition = 0;
	let wasHeroVideoPlaying = false;

	const syncBodyScrollLock = (shouldLock: boolean) => {
		if (shouldLock === isBodyScrollLocked) return;
		if (shouldLock) {
			document.body.style.setProperty('--navbar-menu-scroll-y', `${menuScrollPosition}px`);
			document.documentElement.classList.add('navbar-menu-open');
			document.body.classList.add('navbar-menu-open');
			wasHeroVideoPlaying = Boolean(heroVideo && !heroVideo.paused);
			heroVideo?.pause();
		} else {
			document.body.classList.remove('navbar-menu-open');
			document.documentElement.classList.remove('navbar-menu-open');
			document.body.style.removeProperty('--navbar-menu-scroll-y');
			window.scrollTo({ top: menuScrollPosition, behavior: 'instant' });
			if (wasHeroVideoPlaying && heroVideo) void heroVideo.play().catch(() => {});
		}
		isBodyScrollLocked = shouldLock;
	};

	const syncMenuVisibility = () => {
		if (!menu || !menuToggle) return;
		menu.hidden = !desktopMenu.matches && !isMenuOpen;
		menuToggle.setAttribute('aria-expanded', String(!desktopMenu.matches && isMenuOpen));
		menuToggle.setAttribute('aria-label', isMenuOpen ? 'Cerrar menú' : 'Abrir menú');
		syncBodyScrollLock(isMenuOpen && !desktopMenu.matches);
	};

	const closeMenu = (restoreFocus = false) => {
		if (!menuToggle || !menu) return;
		isMenuOpen = false;
		syncMenuVisibility();
		if (restoreFocus && !desktopMenu.matches) menuToggle.focus();
	};

	menuToggle?.addEventListener('click', () => {
		if (!isMenuOpen && !desktopMenu.matches) menuScrollPosition = window.scrollY;
		isMenuOpen = !isMenuOpen;
		syncMenuVisibility();
	});
	desktopMenu.addEventListener('change', () => {
		isMenuOpen = false;
		syncMenuVisibility();
	});
	syncMenuVisibility();

	document.addEventListener('click', (event) => {
		const playMode = document.querySelector('#play-mode');
		const clickedGame = Boolean(playMode && event.composedPath().includes(playMode));
		if (clickedGame && isMenuOpen && !desktopMenu.matches) return;
		if (!(event.target instanceof Element) || (!menu?.contains(event.target) && !menuToggle?.contains(event.target))) {
			closeMenu();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isMenuOpen && !desktopMenu.matches) closeMenu(true);
	});

	gameButton?.addEventListener('click', () => {
		if (desktopMenu.matches) closeMenu(true);
		const isPressed = gameButton.getAttribute('aria-pressed') === 'true';
		gameButton.setAttribute('aria-pressed', String(!isPressed));
	});

	let isManualScroll = false;
	let manualScrollTimeout: number | undefined;

	const setActiveNav = (id: string) => {
		let activeLink: HTMLAnchorElement | undefined;
		navLinks.forEach((link) => {
			if (link.getAttribute('data-nav') === id) {
				link.classList.add('is-active');
				activeLink = link;
			} else {
				link.classList.remove('is-active');
			}
		});

		if (activeLink && navActions && activeIndicator && desktopMenu.matches) {
			const actionsRect = navActions.getBoundingClientRect();
			const linkRect = activeLink.getBoundingClientRect();
			activeIndicator.style.width = `${linkRect.width}px`;
			activeIndicator.style.transform = `translateX(${linkRect.left - actionsRect.left}px)`;
		}
	};

	navLinks.forEach((link) => {
		link.addEventListener('click', (e) => {
			closeMenu(true);
			const navId = link.getAttribute('data-nav');
			if (!navId) return;

			isManualScroll = true;
			clearTimeout(manualScrollTimeout);

			if (navId === 'home') {
				e.preventDefault();
				setActiveNav('home');
				window.scrollTo({ top: 0, behavior: 'smooth' });
			} else {
				const targetSection = document.getElementById(navId);
				if (targetSection) {
					e.preventDefault();
					setActiveNav(navId);
					targetSection.scrollIntoView({ behavior: 'smooth' });
				}
			}

			manualScrollTimeout = window.setTimeout(() => {
				isManualScroll = false;
			}, 1000);
		});
	});

	document.querySelector<HTMLAnchorElement>('.version-toggle')?.addEventListener('click', () => closeMenu(true));

	setActiveNav(document.querySelector<HTMLAnchorElement>('.version-two-nav-link.is-active')?.dataset.nav || 'home');
	window.addEventListener('resize', () => setActiveNav(document.querySelector<HTMLAnchorElement>('.version-two-nav-link.is-active')?.dataset.nav || 'home'));

	const observerOptions = {
		root: null,
		rootMargin: '-30% 0px -40% 0px',
		threshold: 0
	};

	const observer = new IntersectionObserver((entries) => {
		if (isManualScroll) return;
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				const id = entry.target.getAttribute('id');
				if (id && ['home', 'laboratorio', 'galeria', 'partidas'].includes(id)) {
					setActiveNav(id);
				}
			}
		});
	}, observerOptions);

	sections.forEach((section) => {
		const id = section.getAttribute('id');
		if (id && ['home', 'laboratorio', 'galeria', 'partidas'].includes(id)) {
			observer.observe(section);
		}
	});
</script>
