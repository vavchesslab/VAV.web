---
import { getCloudinaryGallery } from '../lib/cloudinary';

const {
  title = 'NUESTRAS PIEZAS Y TABLEROS',
  subtitle = ''
} = Astro.props;

const categories = await getCloudinaryGallery();
---

<section id="galeria" class="galeria-section mt-15" aria-label="Galería de imágenes">
  <div class="galeria__inner">
    <p class="mt-0 mb-1 text-lg font-semibold uppercase tracking-[0.22em] text-(--accent) text-center">Galería</p>
    
    <div class="galeria__header text-center mb-6">
      <p class="mt-1 text-base text-(--muted) max-w-xl mx-auto">{subtitle}</p>
    </div>

    {categories.length > 0 && (
      <div class="galeria__selector-wrap">
        <label id="galeria-album-label" for="galeria-album">Elegí un álbum</label>
          <button class="galeria__sheet-scrim" type="button" aria-label="Cerrar selector de álbumes" hidden></button>
        <div class="galeria__select-shell">
          <button id="galeria-album" class="galeria__selector" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="galeria-album-options" aria-labelledby="galeria-album-label galeria-album-current">
            <span id="galeria-album-current">{categories[0].name}</span>
            <svg class="galeria__selector-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="galeria-album-options" class="galeria__options" role="listbox" aria-labelledby="galeria-album-label" hidden>
            {categories.map((category, index) => (
              <button class="galeria__option" type="button" role="option" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-album-value={`album-${index}`}>
                {category.name}
              </button>
            ))}
          </div>
        </div>
      </div>
    )}

    <div class="galeria__categories">
      {categories.map((category, index) => (
        <section class="galeria__category" data-album={`album-${index}`} hidden={index !== 0}>
          <div class="galeria__grid">
            {category.images.map((image) => (
              <article class="galeria__item group">
                <div class="galeria__card">
                  <div class="galeria__image-placeholder">
                    <button class="galeria__image-button" type="button" data-lightbox-src={image.url} data-lightbox-alt={`${category.name}: ${image.title}`} data-lightbox-title={image.title} data-lightbox-category={category.name} aria-label={`Ver ${image.title} en grande`}>
                      <img src={image.url} alt={`${category.name}: ${image.title}`} loading="lazy" width={image.width} height={image.height} />
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
            <div class="galeria__pagination" role="group" aria-label={`Imágenes de ${category.name}`} hidden={category.images.length < 2}>
              {category.images.map((image, slideIndex) => (
                <button
                  class="galeria__pagination-dot"
                  type="button"
                  data-slide-to={slideIndex}
                  aria-label={`Ver imagen ${slideIndex + 1} de ${category.images.length}`}
                  aria-current={slideIndex === 0 ? 'true' : 'false'}
                />
              ))}
            </div>
        </section>
      ))}
    </div>

    {categories.length === 0 && (
      <p class="galeria__empty">No hay álbumes disponibles en este momento.</p>
    )}
  </div>

  <div class="galeria__lightbox" id="galeria-lightbox" hidden role="dialog" aria-modal="true" aria-label="Imagen ampliada">
    <div class="galeria__lightbox-toolbar">
      <div>
        <p id="galeria-lightbox-category" class="galeria__lightbox-category"></p>
      </div>
      <button class="galeria__lightbox-close" type="button" aria-label="Cerrar imagen ampliada">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <div class="galeria__lightbox-viewer">
      <button id="galeria-lightbox-prev" class="galeria__lightbox-arrow" type="button" aria-label="Imagen anterior">
        <svg class="galeria__lightbox-arrow-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <img id="galeria-lightbox-image" class="galeria__lightbox-image" alt="" draggable="false" />
      <button id="galeria-lightbox-next" class="galeria__lightbox-arrow" type="button" aria-label="Imagen siguiente">
        <svg class="galeria__lightbox-arrow-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <div id="galeria-lightbox-dots" class="galeria__lightbox-dots" role="group" aria-label="Navegación de imágenes"></div>
    <div id="galeria-lightbox-thumbnails" class="galeria__lightbox-thumbnails" aria-label="Miniaturas del álbum"></div>
    <p id="galeria-lightbox-position" class="galeria__lightbox-position" aria-live="polite"></p>
  </div>
</section>

<script>
  const albumSelector = document.querySelector<HTMLButtonElement>('#galeria-album');
  const albumSelectorLabel = document.querySelector<HTMLLabelElement>('#galeria-album-label');
  const albumCurrent = document.querySelector<HTMLElement>('#galeria-album-current');
  const albumOptions = document.querySelector<HTMLElement>('#galeria-album-options');
  const albumSelectorWrap = document.querySelector<HTMLElement>('.galeria__selector-wrap');
  const albumSheetScrim = document.querySelector<HTMLButtonElement>('.galeria__sheet-scrim');
  const albumOptionsParent = albumOptions?.parentElement;
  const albumOptionsNextSibling = albumOptions?.nextSibling || null;
  const albumSheetScrimParent = albumSheetScrim?.parentElement;
  const albumSheetScrimNextSibling = albumSheetScrim?.nextSibling || null;
  const mobileAlbumSheet = window.matchMedia('(max-width: 640px)');
  let previousBodyOverflow = '';
  const carouselGrids = Array.from(document.querySelectorAll<HTMLElement>('.galeria__grid'));

  const updateCarouselPagination = (grid: HTMLElement, selectedIndex?: number) => {
    const dots = Array.from(grid.nextElementSibling?.querySelectorAll<HTMLButtonElement>('.galeria__pagination-dot') || []);
    if (dots.length < 2) return;
    const activeIndex = selectedIndex ?? Math.round(grid.scrollLeft / Math.max(1, grid.clientWidth));
    dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === activeIndex)));
  };

  carouselGrids.forEach((grid) => {
    let scrollFrame = 0;
    grid.addEventListener('scroll', () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        updateCarouselPagination(grid);
        scrollFrame = 0;
      });
    }, { passive: true });

    grid.nextElementSibling?.querySelectorAll<HTMLButtonElement>('.galeria__pagination-dot').forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.slideTo || 0);
        grid.scrollTo({ left: index * grid.clientWidth, behavior: 'smooth' });
      });
    });
  });

  const restoreAlbumSheetNodes = () => {
    if (albumOptions && albumOptionsParent) albumOptionsParent.insertBefore(albumOptions, albumOptionsNextSibling);
    if (albumSheetScrim && albumSheetScrimParent) albumSheetScrimParent.insertBefore(albumSheetScrim, albumSheetScrimNextSibling);
  };
  const albumOptionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.galeria__option'));
  const albums = document.querySelectorAll<HTMLElement>('[data-album]');

  const closeAlbumOptions = (restoreFocus = false) => {
    if (!albumSelector || !albumOptions) return;
    albumSelector.setAttribute('aria-expanded', 'false');
    albumOptions.hidden = true;
    if (albumSelectorWrap?.classList.contains('is-sheet-open')) {
      albumSelectorWrap.classList.remove('is-sheet-open');
      if (albumSheetScrim) albumSheetScrim.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      restoreAlbumSheetNodes();
    }
    if (restoreFocus) albumSelector.focus();
  };

  const openAlbumOptions = () => {
    if (!albumSelector || !albumOptions) return;
    if (mobileAlbumSheet.matches && albumSelectorWrap && albumSheetScrim) {
      previousBodyOverflow = document.body.style.overflow;
      albumSelectorWrap.classList.add('is-sheet-open');
      albumSheetScrim.hidden = false;
      document.body.style.overflow = 'hidden';
      document.body.append(albumSheetScrim, albumOptions);
    }
    albumSelector.setAttribute('aria-expanded', 'true');
    albumOptions.hidden = false;
    (albumOptionButtons.find((option) => option.getAttribute('aria-selected') === 'true') || albumOptionButtons[0])?.focus();
  };

  albumSheetScrim?.addEventListener('click', () => closeAlbumOptions(true));
  mobileAlbumSheet.addEventListener('change', () => {
    if (!mobileAlbumSheet.matches) closeAlbumOptions();
  });
  document.addEventListener('keydown', (event) => {
    if (mobileAlbumSheet.matches && event.key === 'Escape' && albumOptions && !albumOptions.hidden) closeAlbumOptions(true);
  });

  const selectAlbum = (option: HTMLButtonElement) => {
    const value = option.dataset.albumValue;
    if (!value || !albumSelector || !albumCurrent) return;

    albums.forEach((album) => {
      album.hidden = album.dataset.album !== value;
    });
    const selectedAlbum = Array.from(albums).find((album) => album.dataset.album === value);
    const selectedGrid = selectedAlbum?.querySelector<HTMLElement>('.galeria__grid');
    if (selectedGrid) {
      selectedGrid.scrollLeft = 0;
      updateCarouselPagination(selectedGrid, 0);
    }
    albumCurrent.textContent = option.textContent?.trim() || '';
    albumOptionButtons.forEach((item) => {
      const isSelected = item === option;
      item.setAttribute('aria-selected', String(isSelected));
      item.tabIndex = isSelected ? 0 : -1;
    });
    closeAlbumOptions(true);
  };

  albumSelector?.addEventListener('click', () => {
    if (albumSelector.getAttribute('aria-expanded') === 'true') closeAlbumOptions();
    else openAlbumOptions();
  });

  albumSelectorLabel?.addEventListener('click', (event) => {
    event.preventDefault();
    openAlbumOptions();
  });

  albumSelector?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      openAlbumOptions();
    } else if (event.key === 'Escape') {
      closeAlbumOptions();
    }
  });

  albumOptions?.addEventListener('click', (event) => {
    const option = (event.target as Element).closest<HTMLButtonElement>('.galeria__option');
    if (option) selectAlbum(option);
  });

  albumOptions?.addEventListener('keydown', (event) => {
    const currentIndex = albumOptionButtons.indexOf(document.activeElement as HTMLButtonElement);
    let nextIndex = currentIndex;

    if (event.key === 'ArrowDown') nextIndex = (currentIndex + 1) % albumOptionButtons.length;
    else if (event.key === 'ArrowUp') nextIndex = (currentIndex - 1 + albumOptionButtons.length) % albumOptionButtons.length;
    else if (event.key === 'Home') nextIndex = 0;
    else if (event.key === 'End') nextIndex = albumOptionButtons.length - 1;
    else if (event.key === 'Escape') {
      event.preventDefault();
      closeAlbumOptions(true);
      return;
    } else if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      albumOptionButtons[currentIndex]?.click();
      return;
    } else {
      return;
    }

    event.preventDefault();
    albumOptionButtons[nextIndex]?.focus();
  });

  document.addEventListener('click', (event) => {
    const clickedInsideSelector = event.target instanceof Node && (
      albumSelectorWrap?.contains(event.target)
      || albumOptions?.contains(event.target)
      || albumSheetScrim?.contains(event.target)
    );
    if (event.target instanceof Node && !clickedInsideSelector) {
      closeAlbumOptions();
    }
  });

  const lightbox = document.querySelector<HTMLElement>('#galeria-lightbox');
  const lightboxImage = document.querySelector<HTMLImageElement>('#galeria-lightbox-image');
  const lightboxCategory = document.querySelector<HTMLElement>('#galeria-lightbox-category');
  const lightboxPrev = document.querySelector<HTMLButtonElement>('#galeria-lightbox-prev');
  const lightboxNext = document.querySelector<HTMLButtonElement>('#galeria-lightbox-next');
  const lightboxViewer = document.querySelector<HTMLElement>('.galeria__lightbox-viewer');
  const lightboxDots = document.querySelector<HTMLElement>('#galeria-lightbox-dots');
  const lightboxThumbnails = document.querySelector<HTMLElement>('#galeria-lightbox-thumbnails');
  const lightboxPosition = document.querySelector<HTMLElement>('#galeria-lightbox-position');
  const lightboxClose = document.querySelector<HTMLButtonElement>('.galeria__lightbox-close');
  const imageButtons = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]');
  let activeButtons: HTMLButtonElement[] = [];
  let activeIndex = 0;
  let touchStartX = 0;
  let touchStartY = 0;
  let multiTouchGesture = false;

  if (lightbox) document.body.append(lightbox);

  const renderThumbnails = () => {
    if (!lightboxThumbnails) return;
    lightboxThumbnails.replaceChildren(...activeButtons.map((button, index) => {
      const thumbnail = document.createElement('button');
      thumbnail.type = 'button';
      thumbnail.className = 'galeria__lightbox-thumbnail';
      thumbnail.setAttribute('aria-label', `Ver ${button.dataset.lightboxTitle || 'imagen'} ${index + 1}`);
      thumbnail.addEventListener('click', () => showImage(index));
      const image = document.createElement('img');
      image.src = button.dataset.lightboxSrc || '';
      image.alt = button.dataset.lightboxAlt || '';
      thumbnail.append(image);
      return thumbnail;
    }));
  };

  const renderLightboxDots = () => {
    if (!lightboxDots) return;
    lightboxDots.replaceChildren(...activeButtons.map((button, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'galeria__lightbox-dot';
      dot.setAttribute('aria-label', `Ver imagen ${index + 1} de ${activeButtons.length}`);
      dot.setAttribute('aria-current', String(index === activeIndex));
      dot.addEventListener('click', () => showImage(index));
      return dot;
    }));
  };

  const showImage = (index: number) => {
    if (!lightboxImage || activeButtons.length === 0) return;
    activeIndex = (index + activeButtons.length) % activeButtons.length;
    const button = activeButtons[activeIndex];
    lightboxImage.src = button.dataset.lightboxSrc || '';
    lightboxImage.alt = button.dataset.lightboxAlt || '';
    if (lightboxCategory) lightboxCategory.textContent = button.dataset.lightboxCategory || '';
    if (lightboxPosition) lightboxPosition.textContent = `Imagen ${activeIndex + 1} de ${activeButtons.length}`;
    lightboxDots?.querySelectorAll<HTMLButtonElement>('.galeria__lightbox-dot').forEach((dot, dotIndex) => {
      dot.setAttribute('aria-current', String(dotIndex === activeIndex));
    });
    lightboxThumbnails?.querySelectorAll<HTMLButtonElement>('.galeria__lightbox-thumbnail').forEach((thumbnail, thumbnailIndex) => {
      thumbnail.classList.toggle('is-active', thumbnailIndex === activeIndex);
      if (thumbnailIndex === activeIndex) thumbnail.setAttribute('aria-current', 'true');
      else thumbnail.removeAttribute('aria-current');
    });
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImage) return;
    lightbox.hidden = true;
    lightboxImage.removeAttribute('src');
    document.body.style.overflow = '';
  };

  imageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      const album = button.closest<HTMLElement>('[data-album]');
      activeButtons = Array.from(album?.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]') || []);
      activeIndex = activeButtons.indexOf(button);
      renderThumbnails();
      renderLightboxDots();
      showImage(activeIndex);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  lightboxPrev?.addEventListener('click', () => showImage(activeIndex - 1));
  lightboxNext?.addEventListener('click', () => showImage(activeIndex + 1));

  lightboxViewer?.addEventListener('touchstart', (event) => {
    if (!window.matchMedia('(max-width: 640px)').matches) return;
    if (event.touches.length > 1) {
      multiTouchGesture = true;
      return;
    }
    if (multiTouchGesture) return;
    const touch = event.changedTouches[0];
    touchStartX = touch.clientX;
    touchStartY = touch.clientY;
  }, { passive: true });

  lightboxViewer?.addEventListener('touchmove', (event) => {
    if (event.touches.length > 1) multiTouchGesture = true;
  }, { passive: true });

  lightboxViewer?.addEventListener('touchend', (event) => {
    if (!window.matchMedia('(max-width: 640px)').matches) return;
    if (event.touches.length > 0 || multiTouchGesture) {
      if (event.touches.length === 0) multiTouchGesture = false;
      return;
    }
    const touch = event.changedTouches[0];
    const deltaX = touch.clientX - touchStartX;
    const deltaY = touch.clientY - touchStartY;
    if (Math.abs(deltaX) < 55 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
    showImage(activeIndex + (deltaX < 0 ? 1 : -1));
  }, { passive: true });

  lightboxViewer?.addEventListener('touchcancel', () => {
    multiTouchGesture = false;
  }, { passive: true });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && !target.closest('.galeria__lightbox-image, .galeria__lightbox-arrow, .galeria__lightbox-thumbnail, .galeria__lightbox-dot, .galeria__lightbox-close')) {
      closeLightbox();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
    if (event.key === 'ArrowLeft' && lightbox && !lightbox.hidden) showImage(activeIndex - 1);
    if (event.key === 'ArrowRight' && lightbox && !lightbox.hidden) showImage(activeIndex + 1);
  });
</script>

<style>
  .galeria-section {
    width: 100%;
    padding: 0 0 5rem;
    background: transparent;
  }

  section.galeria-section {
    scroll-margin-top: 112px;
  }

  .galeria__inner {
    width: min(100%, 1500px);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .galeria__selector-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin: 2rem auto 1.5rem;
  }

  .galeria__selector-wrap label {
    color: var(--gold-light, #fff1a8);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .galeria__select-shell {
    position: relative;
    width: 13rem;
    max-width: calc(100vw - 2rem);
  }

  .galeria__selector {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.8rem;
    padding: 0.62rem 0.8rem 0.62rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--gold-base, #d4a72c) 48%, transparent);
    border-radius: 0.7rem;
    color: #f5f5f5;
    background: rgba(12, 22, 26, 0.82);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .galeria__selector:hover {
    border-color: var(--gold-base, #d4a72c);
    background: rgba(17, 31, 35, 0.94);
  }

  .galeria__selector:focus-visible {
    border-color: var(--gold-light, #fff1a8);
    outline: 2px solid color-mix(in srgb, var(--gold-base, #d4a72c) 48%, transparent);
    outline-offset: 3px;
  }

  .galeria__selector[aria-expanded="true"] .galeria__selector-icon {
    color: var(--gold-light, #fff1a8);
    transform: rotate(180deg);
  }

  .galeria__selector-icon {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    color: var(--gold-base, #d4a72c);
    pointer-events: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .galeria__options {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    left: 0;
    z-index: 20;
    display: grid;
    gap: 0.2rem;
    max-height: min(18rem, 50vh);
    padding: 0.35rem;
    overflow-y: auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.7rem;
    background: rgba(8, 17, 20, 0.98);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .galeria__options[hidden] {
    display: none;
  }

  .galeria__pagination { display: none; }

  .galeria__option {
    width: 100%;
    padding: 0.6rem 0.65rem;
    border: 0;
    border-radius: 0.4rem;
    color: rgba(245, 245, 245, 0.82);
    background: transparent;
    font: inherit;
    font-size: 0.82rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .galeria__option:hover,
  .galeria__option:focus-visible {
    outline: none;
    color: #fff1a8;
    background: rgba(212, 167, 44, 0.14);
  }

  .galeria__option[aria-selected="true"] {
    color: #fff1a8;
    background: rgba(212, 167, 44, 0.2);
  }

  .galeria__empty {
    margin: 2rem 0;
    color: var(--muted);
    text-align: center;
  }

  .galeria__card {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(18, 44, 40, 0.4);
    backdrop-filter: blur(8px);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .galeria__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .galeria__image-placeholder {
    height: 280px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(20, 125, 114, 0.25), rgba(12, 22, 26, 0.8));
  }

  .galeria__image-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeria__image-button {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .galeria__image-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .galeria__lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.88);
  }

  .galeria__lightbox[hidden] {
    display: none;
  }

  .galeria__lightbox-image {
    position: relative;
    z-index: 0;
    max-width: min(82vw, 1100px);
    max-height: min(68vh, 720px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.35rem;
    box-shadow: 0 1rem 4rem rgba(0, 0, 0, 0.55);
    user-select: none;
  }

  .galeria__lightbox-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: min(100%, 1100px);
    min-height: 4rem;
    margin: 0 auto 0.5rem;
    color: #fff;
  }

  .galeria__lightbox-category {
    margin: 0.85rem 0 0.25rem;
